#
# | 1 ( { الإكمال } من عويمر بن ساعدة رضي الله عنه ) 1
# 33512 - نعم العبد من عباد الله والرجل من أهل الجنة عويمر بن ساعدة .
# % ( الديلمي - عن جابر ) .
# | 1 ( عبد الله بن عمر رضي الله عنه ) 1
# 33513 - نعم العبد عبد الله بن عمر من وفد الرحمن ! وعمار بن ياسر من
~~السابقين ! والمقداد بن الأسود من المجتهدين .
# % ( فر - عن ابن عباس ) ( عبد الله بن عمر بن الخطاب رضي الله عنهما توفي
~~بمكة ودفن بذي طوى سنة ( 74 ) وعمره ( 84 ) . المستدرك ( 3 / 557 ) ص ) .
# PageV11P329
# 33514 - إن عبد الله رجل صالح لو كان يكثر الصلاة من الليل .
# % ( حم ، ق - عن حفصة ) .
# 33515 - نعم الرجل عبد الله لو كان يصلي من الليل .
# % ( حم ، ق - عن حفصة ) ( أخرجه البخاري في صحيحه كتاب فضائل الأصحاب باب
~~مناقب عمر ( 5 / 31 ) ص ) .
# | 1 ( { الإكمال } من عبد الله بن عمر رضي الله عنه ) 1
# 33516 - لكل أمة عالم وعالم هذه الأمة عبد الله بن عمر ، ولكل نبي خليل
~~وخليلي سعد بن معاذ .
# % ( الديلمي - عن ابن عباس ) .
# | 1 ( عبد الله بن سلام رضي الله عنه ) 1
# 33517 - عبد ms4523 الله بن سلام عاشر عشرة في الجنة .
# % ( حم ، طب ، ك - عن معاذ ) ( الحديث أخرجه الحاكم في المستدرك ( 3 /
~~416 ) وقال : صحيح وأقره الذهبي . وتوفي بالمدينة سنة ( 73 ) ص ) .
# | 1 ( { الإكمال } من عبد الله بن سلام رضي الله عنه ) 1
# 33518 - يموت عبد الله بن سلام وهو آخذ بالعروة الوثقى .
# % ( طب عن عبد الله بن سلام ) .
# 33519 - كذبتم لن يقبل قولكم ، أما آنفا فتثنون عليه من الخير ما أثنيتم
~~، وأما إذا آمن فكذبتموه وقلتم فيه ، فلن يقبل قولكم .
# % ( ك - عن عوف بن مالك ) ( الحديث أخرجه الحاكم في المستدرك ( 3 / 416 )
~~وقال : صحيح وأقره الذهبي . وتوفي بالمدينة سنة ( 73 ) ص ) .
# | 1 ( عمار بن ياسر رضي الله عنه ) 1
# 33520 - عمار خلط الله الإيمان ما بين قرنه إلى قدمه وخلط الإيمان بلحمه
~~ودمه ، يزول مع الحق حيث زال ، وليس ينبغي للنار أن تأكل منه شيئا .
# % ( ابن عساكر - عن علي ) .
# 33521 - دم عمار ولحمه حرام على النار أن تأكله أو تمسه .
# % ( ابن عساكر - عن علي ) .
# 33522 - قاتل عمار وسالبه في النار .
# % ( طب - عن عمرو بن العاص وعن ابنه ) .
# 33523 - كم من ذي طمرين لا يؤبه له لو أقسم على الله لأبره منهم عمار بن
~~ياسر .
# % ( ابن عساكر - عن عائشة ) ( أورده الهيثمي في مجمع الزوائد ( 9 / 294 )
~~وقال : رواه الطبراني في الأوسط وفيه عيسى بن قرطاس وهو متروك . ص ) .
# 33524 - ابن سمية ما عرض عليه أمران قط إلا أخذ بالأرشد منهما .
# % ( حم ، ك - عن ابن مسعود ) .
# 33525 - إذا اختلف الناس كان ابن سمية مع الحق .
# % ( طب - عن ابن مسعود ) .
# 33526 - عمار يزول مع الحق حيث يزول .
# % ( ابن عساكر - عنه ) .
# 33527 - ما خير عمار بين أمرين إلا اختار أرشدهما .
# % ( ت ، ك عن عائشة ) ( أخرجه الترمذي كتاب المناقب باب مناقب عمار رقم (
~~3799 ) وقال : حسن غريب ص ) .
# PageV11P330
# 33528 - عمار ما عرض عليه أمران إلا اختار الأرشد منهما .
# % ( ه - عنها ) ( أخرجه ابن ماجه كتاب المقدمة باب فضل عمار بن ياسر رقم
~~( 147 و 148 ) . والحاكم في المستدرك ( 3 ms4524 / 392 ) وقال : صحيح ص ) .
# 33529 - مليء عمار إيمانا إلى مشاشه ( مشاشه : في صفته عليه السلام (
~~جليل المشاش ) أي عظيم رؤوس العظام كالمرفقين والكتفين ، والركبتين . قال
~~الجوهري : هي رؤوس العظام اللينة التي يمكن مضغها . النهاية ( 4 / 333 ) ب
~~) .
# % ( ه ( أخرجه ابن ماجه كتاب المقدمة باب فضل عمار بن ياسر رقم ( 147 و
~~148 ) . والحاكم في المستدرك ( 3 / 392 ) وقال : صحيح ص ) - عن علي ؛ ك -
~~عن ابن مسعود ) .
# 33530 - عمار مليء إيمانا إلى مشاشه .
# % ( حل - عن علي ) .
# 33531 - ويح عمار تقتله الفئة الباغية ! يدعوهم إلى الجنة ويدعونه إلى
~~النار .
# % ( حم ، خ - عن أبي سعيد ) ( أخرجه البخاري كتاب الجهاد باب مسح الغبار
~~على الناس ( 4 / 25 ) ص ) .
# 33532 - بؤس لك يا ابن سمية ! تقتلك الفئة الباغية .
# % ( حم ، م عن أبي قتادة ) ( أخرجه مسلم كتاب الفتن باب لا تقوم الساعة
~~رقم ( 2915 ) ص ) .
# 33533 - عمار تقتله الفئة الباغية .
# % ( حل - عن أبي قتادة ) .
# 33534 - من عادى عمارا عاداه الله ؛ ومن أبغض عمارا أبغضه الله .
# % ( ن ، حب ، ك - عن خالد بن الوليد ) .
# | 1 ( { الإكمال } من عمار بن ياسر رضي الله عنه ) 1
# 33535 - ابن سمية ما خير بين أمرين إلا اختار أرشدهما .
# % ( حم ، ك - عن ابن مسعود ) ( أخرجه الحاكم في المستدرك ( 3 / 388 ) ص )
~~.
# 33536 - إن ابن سمية ما عرض عليه أمران قط إلا اختار الأرشد منهما .
# % ( حم - عن ابن مسعود ) ( أخرجه الحاكم في المستدرك ( 3 / 388 ) ص ) .
# 33537 - أبو اليقظان على الفطرة ، أبو اليقظان على الفطرة ، أبو اليقظان
~~على الفطرة ، لا يدعها حتى يموت أو يمسه الهرم .
# % ( ن وابن سعد عد وضعفه - عن حذيفة ) ( أخرجه الحاكم في المستدرك ( 3 /
~~384 ) ص ) .
# 33538 - الحق مع عمار ما يغلب عليه دلهة ( دلهة : الدله والدله : ذهاب
~~الفؤاد من هم أو نحوه كما يدله عقل الإنسان من عشق أو غيره ، والتدله :
~~ذهاب العقل من الهوى . انتهى . لسان العرب ( 13 / 488 ) ب ) الكبر .
# % ( عق ، كر - عن محمد بن سعد بن أبي وقاص عن أبيه ) .
# 33539 - أما إنه سيشهد معك مشاهد ms4525 أجرها عظيم وذكرها كثير وثناؤها حسن .
# % ( حل - عن علي ) قال : ذكرت للنبي صلى الله عليه وسلم عمارا قال :
~~فذكره .
# 33540 - إن عمارا مليء إيمانا إلى مشاشه .
# % ( ع ، طب وابن جرير ، كر - عن علي ) .
# 33541 - إن عمارا مليء إيمانا من قرنه إلى قدمه .
# % ( حل - عن ابن عباس ) .
# 33542 - مليء عمار إيمانا إلى المشاش وهو ممن حرم على النار .
# % ( ش - عن القاسم بن مخيمرة مرسلا ) .
# 33543 - أولعتم ( أولعتم بعمار : يقال : ولعت بالشيء أولع ولعا وولوعا ،
~~بفتح الواو ، المصدر والاسم جميعا . وأولعته بالشيء ، وأولع به فهو مولع ،
~~بفتح اللام : أي مغرى به . ومنه الحديث ( أولعت قريشا بعمار ) أي صيرتهم
~~يولعون به . النهاية ( 5 / 226 ) ب ) بعمار يدعوهم إلى الجنة وهم يدعونه
~~إلى النار .
# % ( طب - عن ابن عمر ) .
# 33544 - اللهم ! أولعت قريش بعمار ، قاتل عمار وسالبه في النار .
# % ( ك - عن عمرو بن العاص ) .
# PageV11P331
# 33545 - ما لهم ولعمار ؟ يدعوهم إلى الجنة ويدعونه إلى النار ، قاتله
~~وسالبه في النار .
# % ( ابن عساكر - عن مجاهد عن أسامة بن شريط أو ابن زيد ) .
# 33546 - ما لهم ولعمار ؟ يدعوهم إلى الجنة ويدعونه إلى النار ، وذلك فعل
~~الأشقياء الأشرار . وفي لفظ ش : وذلك دأب الأشقياء الفجار .
# % ( ش وابن عساكر - عن مجاهد مرسلا ؛ قال ابن عساكر : هو المحفوظ ) .
# 33547 - ابن سمية تقتله الفئة الباغية ، قاتله وسالبه في النار .
# % ( خط كر - عن أنس ) .
# 33548 - اللهم بارك في عمار ! ويحك ابن سمية ! تقتلك الفئة الباغية وآخر
~~زادك من الدنيا ضياح ( ضياح : الضياح والضيح بالفتح : اللبن الخاثر يصب فيه
~~الماء ثم يخلط . النهاية ( 3 / 107 ) ب ) من لبن .
# % ( ابن عساكر - عن عائشة ) .
# 33549 - تقتلك الفئة الباغية ، قاتلك في النار - قاله لعمار .
# % ( ابن عساكر - عن أم سلمة ؛ حم ، ابن عساكر - عن عثمان ) .
# 33550 - تقتلك الفئة الباغية .
# % ( ع وأبو عوانة ، عن أبي رافع ؛ م عن أم سلمة ؛ ابن سعد ، ض ، حم - عن
~~أبي سعيد ؛ طب والباوردي وابن قانع ، قط في الأفراد - عن أبي اليسر وزياد
~~بن الفرد معا ؛ طب عن عمرو ؛ ع وابن منده في كتاب الموالاة ms4526 ، طب ، قط في
~~الأفراد عن بن ياسر ؛ ابن عساكر - عن ابن عباس وعن حذيفة وعن أبي هريرة وعن
~~جابر بن سمرة وعن جابر بن عبد الله عن أبي أمامة ) ( أخرجه مسلم كتاب الفتن
~~رقم ( 2916 ) عن أم سلمة والحاكم في المستدرك ( 3 / 391 ) وقال : صحيح
~~وأقره الذهبي ص ) .
# 33551 - تقتلك الفئة الباغية ، وآخر زادك من الدنيا ضيح من لبن .
# % ( تمام وابن عساكر - عن عبد الله بن كعب بن مالك عن أبيه ؛ وابن عساكر
~~- عن عمرو بن العاص ) .
# 33552 - كف يا خالد عن عمار ؟ فإنه من يبغض عمارا يبغضه الله ، ومن يلعن
~~عمارا يلعنه الله .
# % ( ابن عساكر عن ابن عباس ) .
# 33553 - من يحقر عمارا يحقره الله ، ومن يسب عمارا يسبه الله ، ومن يبغض
~~عمارا يبغضه الله .
# % ( ع وابن قانع ، طب ، ض - عن خالد بن الوليد ) .
# 33554 - يا خالد ! لا تسب عمارا ، إنه من يعاد عمارا يعاده الله ، ومن
~~يبغض عمارا يبغضه الله ، ومن يسب عمارا يسبه الله ، ومن يسفه عمارا يسفهه
~~الله ، ومن يحقر عمارا يحقره الله .
# % ( ط وسمويه ، طب ، ك عن خالد بن الوليد ) .
# 33555 - تقتل عمارا الفئة الباغية عن الطريق ، وإن آخر رزقه من الدنيا
~~ضياح من لبن .
# % ( الخطيب - عن حذيفة ) .
# 33556 - يا أبا اليقظان ! لن تموت حتى تقتلك الفئة الباغية عن الطريق .
# % ( ك - عن حذيفة ) .
# PageV11P332
# 33557 - قاتل ابن سمية في النار .
# % ( كر - عن عمرو بن العاص ) .
# 33558 - لن تموت حتى تقتلك الفئة الباغية ، تشرب شربة ضياح من لبن تكن
~~آخر رزقك من الدنيا .
# % ( ك - عن حذيفة ) .
# 33559 - ويح ابن سمية ! تقتله الفئة الباغية .
# % ( ع ، ز ، ك عن حذيفة وابن مسعود معا ؛ ع - عن أبي هريرة ؛ ابن عساكر -
~~عن أم سلمة ؛ الخطيب - عن عمرو بن العاص ) .
# 33560 - ويحك ابن سمية ؟ تقتلك الفئة الباغية .
# % ( ط ، حم وابن سعد - عن ابن سعيد ؛ ع - عن أبي قتادة ؛ قط في الأفراد -
~~عن أبي اليسر وزياد بن الصرد معا ؛ حم وابن سعد - عن ابن عمر ) .
# 33561 - يا عمار ! تقتلك الفئة الباغية .
# % ( ابن عساكر - عن ms4527 زيد ابن أبي أوفى ) .
# 33562 - يا نار ! كوني بردا وسلاما على عمار كما كنت على إبراهيم تقتلك
~~الفئة الباغية .
# % ( ابن عساكر - عن عمرو بن ميمون ) قال : عذب المشركون عمارا بالنار
~~فكان النبي صلى الله عليه وسلم يمر بيده على رأسه ويقول : فذكره قال ابن
~~عساكر : عمرو بن ميمون أدرك النبي صلى الله عليه وسلم ولم يره .
# 33563 - يدخل سالبك وقاتلك النار - قاله لعمار .
# % ( تمام وابن عساكر - عن عمرو بن العاصي ) .
# 33564 - يزعمون أنك ميت وأنك قد قتلت نفسك ، كلا والله ! ما أنت بميت حتى
~~تقتلك الفئة الباغية - قاله لعمار .
# % ( ابن عساكر - عن جابر ) .
# 33565 - أبشروا يا آل عمار ! فإن موعدكم الجنة .
# % ( طس ، ك ، ق ، كر ، ض - عن أبي الزبير عن جابر بن سعد عن أبي الزبير
~~مرسلا ، وعن ابن يوسف المكي مرسلا ) .
# 33566 - صبرا يا أبا ياسر وآل ياسر ! فإن موعدكم الجنة .
# % ( الحاكم في الكنى - عن عبد الله بن جعفر ) .
# 33567 - صبرا يا آل ياسر ! فإن مصيركم إلى الجنة .
# % ( الحارث ، حل عن عثمان ) .
# 33568 - اصبروا يا آل ياسر ! فإن موعدكم الجنة .
# % ( طب - عن عمار ؛ البغوي وابن منده ، طب ، خط ، كر - عن عثمان ) .
# 33569 - اللهم اغفر لآل ياسر ! وقد فعلت .
# % ( حم وابن سعد - عن عثمان بن عفان ) .
# | 1 ( عمرو بن العاصي رضي الله عنه ) 1
# 33570 - إن عمرو بن العاصي من صالحي قريش .
# % ( ت - عن طلحة ) ( أخرجه الترمذي كتاب المناقب باب مناقب لعمرو بن
~~العاص رقم ( 3844 و 3845 ) وقال غريب ص ) .
# 33571 - أسلم الناس وآمن عمرو بن العاص .
# % ( حم ، ت - عن عقبة بن عامر ) ( أخرجه الترمذي كتاب المناقب باب مناقب
~~لعمرو بن العاص رقم ( 3844 و 3845 ) وقال غريب ص ) .
# PageV11P333
# | 1 ( { الإكمال } من عمرو بن العاصي رضي الله عنه ) 1
# 33572 - نعم أهل البيت عبد الله وأبو عبد الله وأم عبد الله .
# % ( ابن عساكر - عن عمرو بن دينار عن جابر ) أن النبي صلى الله عليه وسلم
~~دخل على عمرو بن العاص فقال : فذكره .
# % ( حم وابن عساكر - عن ابن أبي مليكة ms4528 عن طلحة بن عبيد الله بن سعد عن
~~المطلب بن حنطب مرسلا ؛ وعن ابن أبي مليكة مرسلا ؛ وعن عمر بن دينار مرسلا
~~) .
# 33573 - إن عمرو بن العاص لرشيد الأمر .
# % ( ابن عساكر - عن طلحة بن عبيد الله ) .
# 33574 - إن عمرو بن العاص لمن صالحي قريش ، ونعم أهل البيت عبد الله وأبو
~~عبد الله .
# % ( حم ، ع ، عد - عن طلحة بن عبيد الله ) .
# 33575 - اللهم اغفر لعمرو بن العاص - ثلاثا ، كنت إذا ناديته للصدقة
~~جاءني بها .
# % ( عد - عن جابر ) .
# 33576 - يا عمرو ! لذو رأي رشيد في الإسلام .
# % ( طب ، ص - عن طلحة ) .
# 33577 - يا عمرو ! إني أريد أن أبعثك على جيش فيغنمك الله ويسلمك ، وأرغب
~~لك في المال رغبة صالحة ، يا عمرو ! نعما بالمال الصالح للرجل الصالح .
# % ( حم ، ك وابن سعد ، ع ، طب ، هب - عن عمرو ابن العاص ) ( عمرو بن
~~العاص توفي ( 51 ) ه وعمره ( 94 ) ودفن بالمقطم بمصر . المستدرك ( 3 / 452
~~) ص ) .
# | 1 ( عمرو بن تغلب رضي الله عنه ) 1
# 33578 - أما بعد فوالله إني لأعطي الرجل وأدع الرجل ، والذي أدع أحب إلي
~~من الذي أعطي ، ولكن أعطي أقواما لما رأى في قلوبهم من الجزع ( الجزع : هو
~~الحزن والخوف . النهاية ( 1 / 269 ) ب ) والهلع ( الهلع : أشد الجزع والضجر
~~. النهاية ( 5 / 269 ) ب ) ، وأكل أقواما إلى ما جعل الله في قلوبهم من
~~الغنى والخير منهم عمرو بن تغلب .
# % ( خ ( أخرجه البخاري في صحيحه كتاب الجمعة باب من قال في الخطبة بعد
~~الثناء ( 2 / 13 ) ص ) - عن عمرو بن تغلب ) .
# | 1 ( { الإكمال } من عمرو بن تغلب رضي الله عنه ) 1
# 33579 - إني أعطي قوما أخاف ظلعهم ( ظلعهم : هو بفتح اللام أي : ميلهم عن
~~الحق وضعف إيمانهم . النهاية ( 3 / 159 ) ب ) وجزعهم ، وأكل أقواما إلى ما
~~جعل الله في قلوبهم من الخير والغنى منهم عمرو بن تغلب .
# % ( خ ( أخرجه البخاري كتاب الخمس باب ما كان النبي صلى الله عليه وسلم
~~يعطى المؤلفة . . ) ( 4 / 114 ) ص ) - عن عمرو بن تغلب ) .
# 33580 - إني أعطي أناسا والذي أدع أحب ms4529 إلي من الذي أعطي ، أعطي أناسا لما
~~في قلوبهم من الجزع والهلع ، وأكل أقواما إلى ما جعل الله في قلوبهم من
~~الغنى والخير منهم عمرو بن تغلب .
# % ( حم - عن عمرو ابن تغلب ) .
# | 1 ( عبد الله بن عباس رضي الله عنه ) 1
#
# | 1 ( { الإكمال } من عبد الله بن عباس رضي الله عنه ) 1
# 33581 - إن حبر هذه الأمة لعبد الله بن عباس .
# % ( ك وتعقب - عن ابن عمر ) ( عبد الله بن عباس توفي النبي صلى الله عليه
~~وسلم وعمره خمسة عشر عاما وتوفي سنة ثمان وستين المستدرك للحاكم ( 3 / 543
~~) ص ) .
# 33582 - نعم ترجمان القرآن أنت .
# % ( حل - عن ابن عباس ) ( أخرجه الحاكم في المستدرك ( 3 / 537 ) وقال :
~~صحيح وأقره الذهبي ص ) .
# PageV11P334
# 33583 - نعم الترجمان أنت .
# % ( طب - عن ابن عباس ) .
# 33584 - اللهم ! اعط ابن عباس الحكمة وعلمه التأويل .
# % ( حم ، طب ، حل - عن ابن عباس ؛ ابن سعد ، حم ، طب ، ك - عن ابن عباس )
~~.
# 33585 - اللهم ! بارك فيه وانشر منه - قاله لابن عباس .
# % ( حل - عن ابن عمر ) .
# 33586 - اللهم ! علمه الحكمة وتأويل الكتاب .
# % ( ه وابن سعد ، طب - عن ابن عباس ) .
# 33587 - اذهبي بأبي الخلفاء .
# % ( خط - عن ابن عباس عن أمه أم الفضل ) .
# | 1 ( عبد الله بن حذافة رضي الله عنه ) 1
#
# | 1 ( { الإكمال } من عبد الله بن حذافة رضي الله عنه ) 1
# 33588 - أبوك حذافة ، أنجبت أم حذافة ، الولد للفراش .
# % ( ابن سعد ، ك - عن أبي وائل ) قال : قام عبد الله بن حذافة فقال : يا
~~رسول الله من أبي ؟ قال - فذكره ( أخرجه الحاكم في المستدرك : ( 3 / 631 )
~~ولم يذكر الحاكم كعادته من تصحيح لهذا الحديث وكذا الذهبي لم يعرج كعادته
~~في التصحيح لهذا الحديث وكذا الذهبي لم يعرج كعادته في التصحيح أو غيره
~~فالحاكم والذهبي سكتا عن هذا الحديث ص ) .
# | 1 ( عبد الله بن رواحة رضي الله عنه من الإكمال ) 1
# 33589 - نعم الرجل عبد الله بن رواحة .
# % ( ابن عساكر - عن أبي هريرة ) .
# 33590 - رحم الله ابن رواحة ! إنه يحب المجالس التي تتباهى بها الملائكة
~~.
# % ( حم ms4530 - عن أنس ) .
# | 1 ( عبد الله بن الزبير رضي الله عنه من الإكمال ) 1
# 33591 - ويل لك من الناس ! وويل للناس منك ! لا تمسك النار إلا قسم
~~اليمين - قاله لابن الزبير .
# % ( حل - عن كيسان مولى عبد الله ابن الزبير ) ( أول مولود ولد بعد
~~الهجرة عبد الله بن الزبير وأمه أسماء بنت أبي بكر الصديق . الحاكم في
~~المستدرك ( 3 / 550 ) ص ) .
# | 1 ( عبد الله بن جعفر رضي الله عنه ( ولدت أسماء بنت عميس عبد الله بن
~~جعفر بن أبي طالب بأرض الحبشة وتوفي سنة ( 80 ) وعمره كذلك ( 80 ) سنة .
~~الحاكم في المستدرك ( 3 / 566 ) ص ) من الإكمال ) 1
# 33592 - أما محمد فشبيه عمنا أبي طالب ، وأما عبد الله فشبيه خلقي وخلقي
~~.
# % ( ط وابن سعد ، حم ، طب ، حل وأبو نعيم في المعرفة ، ك ، كر - عن عبد
~~الله بن جعفر ) .
# 33593 - يا عبد الله هنيئا لك مريئا ! خلقت من طيني ، وأبوك يطير مع
~~الملائكة في السماء .
# % ( ابن عساكر - عن علي بن عبد الله بن جعفر عن أبيه ) .
# | 1 ( عبد الله ذو البجادين رضي الله عنه من الإكمال ) 1
# 33594 - رحمك الله ! إن كنت لأواها تلاء للقرآن - قاله لعبد الله ذي
~~البجادين .
# % ( ت ( أخرجه الترمذي كتاب الجنائز باب ما جاء في الدفن بالليل رقم (
~~1057 ) وقال : حسن . ص ) ، طس ، حل - عن ابن عباس ) .
# PageV11P335
# | 1 ( عبد الله بن بسر رضي الله عنه من الإكمال ) 1
# 33595 - يعيش هذا الغلام قرنا - قاله لعبد الله بن بسر .
# % ( حم ( أورده الهيثمي في مجمع الزوائد ( 9 / 404 و 405 ) وقال : رواه
~~الطبراني والبزار ورجال أحد إسنادي البزار رجال الصحيح غير الحسن بن أيوب
~~الحضرمي وهو ثقة . ص ) وابن جرير طب وابن منده وتمام ، ك ، هق في الدلائل -
~~عن عبد الله بن بسر ) .
# | 1 ( عبد الله بن أنيس رضي الله عنه من الإكمال ) 1
# 33596 - تخصر بهذه حتى تلقاني بها يوم القيامة وأقل الناس المتخصرون .
# % ( حل - عن عبد الله بن أنيس ) أن رسول الله صلى الله عليه وسلم أعطاه
~~مخصرة وقال ms4531 : فذكره .
# 33597 - خذ هذه فتخصر بها يوم القيامة فإن المتخصرين يومئذ قليل ، قال :
~~يا رسول الله ! مماذا ؟ قال : آية بيني وبينك يوم القيامة .
# % ( ابن سعد ، حم ، ع وابن خزيمه ، حب ، طب ، ص - عن عبد الله ابن أنيس
~~الأنصاري ) .
# | 1 ( عبد الله أبو سلمة بن عبد الأسد رضي الله عنه من الإكمال ) 1
# 33598 - أول من يعطى كتابه بيمينه أبو سلمة بن عبد الأسد ، وأول من يعطى
~~كتابه بشماله أخوه أبو سفيان بن عبد الأسد .
# % ( الديلمي عن ابن عباس ؛ وفيه حبيب بن زريق كاتب مالك ) .
# 33599 - اللهم اغفر لأبي سلمة وارفع درجته في المقربين واخلفه في عقبه في
~~الغابرين واغفر لنا وله يا رب العالمين ، وافسح له في قبره ونور له فيه .
# % ( حم ، م ، د - عن أم سلمة ) ( أخرجه أحمد في مسنده ( 5 / 297 ) ومسلم
~~في صحيحه كتاب الجنائز باب في أغماض الميت . . . ) رقم ( 920 ) وأول الحديث
~~: ( إن الروح إذا قبض تبعه البصر . . . ) ص ) .
# | 1 ( أبو هند عبد الله وقيل يسار وقيل سالم رضي الله عنه من الإكمال ) 1
# 33600 - من سره أن ينظر إلى من صور الله الكتاب في قلبه فلينظر إلى أبي
~~هند . أنكحوا أبا هند وانكحوا إليه .
# % ( عد - عن عائشة ) ( قال ابن الأثير في أسد الغابة ( 6 / 322 ) أبو هند
~~الحجام البياضي مولى فروة بن عمرو ، اسمه عبد الله وقيل يسار وذكر الحديث -
~~وكذا ذكره ابن الأثير في أسد الغابة ( 5 / 519 ) ص ) .
# | 1 ( عبيد بن سليم أبو عامر رضي الله عنه من الإكمال ) 1
# 33601 - اللهم اجعل عبيدا أبا عامر فوق أكثر الناس يوم القيامة .
# % ( ابن سعد ، طب - عن أبي موسى ) ( أبو عامر الأشعري ، اسمه عبيد بن سلم
~~بن حضار . راجع أسد الغابة ( 6 / 188 ) ص ) .
# 33602 - اللهم اغفر لعبيد أبي عامر ! اللهم اجعله يوم القيامة فوق كثير
~~من خلقك ! اللهم اغفر لعبد الله بن قيس ذنبه وأدخله يوم القيامة مدخلا
~~كريما .
# % ( خ ، م - عن أبي موسى ) ( أخرجه مسلم كتاب فضائل الصحابة باب من فضائل
~~أبي موسى ms4532 رقم ( 2498 ) . ص ) .
# | 1 ( عبيدة بن صيفي الجعفي رضي الله عنه ( أورده ابن الأثير في أسد
~~الغابة ( 3 / 552 ) ص ) من الإكمال ) 1
# 33603 - يا عبيدة ! أنتم أهل البيت لا يصيبكم خصاصة إلا فرجها الله عز
~~وجل .
# % ( أبو نعيم - عن عبيدة بن صيفي الجعفي ) .
# PageV11P336
# | 1 ( عتاب بن أسيد رضي الله عنه ( عتاب بن أسيد بن أبي العيص . وأورد
~~الحديث ابن الأثير في أسد الغابة ( 3 / 551 ) ص ) من الإكمال ) 1
# 33604 - رأيت فيما يرى النائم كأن عتاب بن أسيد أتى باب الجنة فأخذ بحلقة
~~الباب فقلقلها حتى فتح له فدخل .
# % ( الديلمي - عن أنس ) .
# | 1 ( عتبة بن أبي لهب ( هو ابن عم النبي صلى الله عليه وسلم وأمه أم
~~جميل . راجع ترجمته في أسد الغابة ( 3 / 569 ) ص ) رضي الله عنه من الإكمال
~~) 1
# 33605 - إني استوهبت ابني عمي هذين من ربي فوهبهما لي - يعني عتبة بن أبي
~~لهب وأخاه معتبا .
# % ( ابن سعد - عن ابن عباس ) .
# | 1 ( عثمان بن مظعون رضي الله عنه ( عثمان بن مظعون بن حبيب وهو أول رجل
~~مات بالمدينة سنة اثنتين من الهجرة وهو أول من دفن بالبقيع . ص ) من
~~الإكمال ) 1
# 33606 - الحق بسلفنا الصالح عثمان بن مظعون .
# % ( طب - عن الأسود ابن سريع ) قال : لما مات إبراهيم بن رسول الله صلى
~~الله عليه وسلم قال : فذكره .
# 33607 - ذهبت ولم تلبس منها بشيء .
# % ( ابن سعد - عن أبي النضر ) قال : لما مر بجنازة عثمان بن مظعون قال
~~رسول الله صلى الله عليه وسلم : فذكره ( حل عن أبي النضر عن زياد عن ابن
~~عباس ) .
# 33608 - الحقي بسلفنا الخير عثمان بن مظعون .
# % ( ط وابن سعد ، طب ، ك - عن ابن عباس ) قال : لما ماتت زينب بنت رسول
~~الله صلى الله عليه وسلم قال : فذكره .
# 33609 - إن ابن مظعون لحي ستير .
# % ( ابن سعد ، طب - عن سعد ابن مسعود وعمارة بن غراب اليحصبي ) .
# 33610 - رحمك الله يا عثمان ! ما أصبت من الدنيا وما أصابت منك يعني ابن
~~مظعون .
# % ( حل - عن عبد ربه بن ms4533 سعيد المدني ) .
# 33611 - اذهب عنها أبا السائب ! فقد خرجت منها ولم تلبس منها بشيء - يعني
~~ابن مظعون .
# % ( حل - عن ابن عباس ) .
# | 1 ( عثمان بن عامر أبو قحافة رضي الله عنه من الإكمال ) 1
# 33612 - لو أقررت الشيخ في بيته لأتيناه تكرمة لأبي بكر .
# % ( حم وأبو عوانة ، حب ، ك - عن أنس ) ( أخرجه الحاكم في المستدرك ( 3 /
~~244 ) صحيح وأقره الذهبي ص ) .
# 33613 - هلا تركت الشيخ في بيته حتى أجيئه - يعني أبا بكر .
# % ( ك - عن أسماء ) .
# 33614 - هلا تركت الشيخ عني آتيه ؟ إنا لنحفظه لأيادي ابنه علينا .
# % ( ك وتعقب - عن القاسم بن محمد عن أبيه عن أبي بكر ؛ قال الذهبي :
~~القاسم لم يدرك أباه ولا أبوه أبا بكر ) ( أخرجه الحاكم في المستدرك ( 3 /
~~244 ) وقال الذهبي : عبد الله منكر الحديث . ص ) .
# PageV11P337
# | 1 ( عروة بن مسعود رضي الله عنه من الإكمال ) 1
# 33615 - مثل عروة مثل صاحب يس دعا قومه إلى الله تعالى فقتلوه .
# % ( طب ، ك - عن عروة مرسلا ) ( أخرجه الحاكم في المستدرك ( 3 / 616 )
~~ولم يذكر الحاكم ولا الذهبي عن هذا الحديث بشيء ولكن في سنده : ابن لهيعة ص
~~) .
# | 1 ( عقيل بن أبي طالب ( أخرجه الحاكم في المستدرك ( 3 / 576 ) وسكتا عن
~~درجة الحديث . وعقيل بن أبي طالب يكنى أبا يزيد أمه فاطمة بنت أسد وتوفي في
~~خلافة معاوية . أسد الغابة ( 4 / 66 ) ص ) رضي الله عنه من الإكمال ) 1
# 33616 - يا عقيل ! والله إني لأحبك لخصلتين : لقرابتك ، ولحب أبي طالب
~~إياك ؛ وأما أنت يا جعفر ! فإن خلقك يشبه خلقي ؛ وأما أنت يا علي فأنت مني
~~بمنزلة هارون من موسى غير أنه لا نبي بعدي .
# % ( ابن عساكر - عن عبد الله بن عقيل عن أبيه عن جده عقيل بن أبي طالب )
~~.
# 33617 - يا أبا يزيد ! إني لأحبك حبين : حبا لقرابتك مني ، وحبا لما كنت
~~أعلم من حب عمي إياك - قاله لعقيل بن أبي طالب .
# % ( ابن سعدج والبغوي ، طب ، وابن عساكر - عن أبي إسحاق مرسلا ؛ ك - عن
~~أبي حذيفة ) .
# 33618 - إني أحبك حبين : حبا ms4534 لقرابتك مني وحبا لما كنت أعلم من حب عمي
~~إياك - قاله لعقيل بن طالب .
# % ( ابن سعد والبغوي ، طب ، ك وابن عساكر - عن أبي إسحاق مرسلا ؛ ك - عن
~~أبي حذيفة ) .
# 33619 - إني لأحبك حبين : حبا لك وحبا لحب أبي طالب لك .
# % ( ابن عساكر - عن عبد الرحمن بن سابط ) قال : كان النبي صلى الله عليه
~~وسلم يقول لعقيل : فذكره .
# 33620 - مرحبا بك يا أبا يزيد ! كيف أصبحت - قاله لعقيل .
# % ( الديلمي - عن جابر ) .
# | 1 ( عكرمة بن أبي الجهل رضي الله عنه ) 1
# 33621 - رأيت لأبي جهل عذقا في الجنة فلما أسلم عكرمة قلت : هذا هو .
# % ( طب ، ك - عن أم سلمة ) ( أورده ابن الأثير في أسد الغابة ( 4 / 73 )
~~ص ) .
# | 1 ( { الإكمال } من عكرمة بن أبي الجهل رضي الله عنه ) 1
# 33622 - لا ، ولكني تبسمت إذ كانا جميعا في درجة واحدة في الجنة .
# % ( ابن عساكر - عن يزيد بن أبي حبيب ) أن عكرمة بن أبي جهل قتل رجلا من
~~الأنصار يقال له المحذر فأخبر رسول الله صلى الله عليه وسلم بذلك فتبسم ،
~~فقال له رجل من الأنصار : يا رسول الله ! تبسمت أن قتل رجل من قومك رجلا من
~~قومنا ؟ قال : فذكره .
# 33623 - ما ذاك أضحكني ولكنه قتله وهو معه في درجته .
# % ( ابن عساكر - عن أنس ) قال : قتل عكرمة بن أبي جهل صخرا الأنصاري فبلغ
~~ذلك النبي صلى الله عليه وسلم فضحك ،
# PageV11P338 فقالت الأنصار : يا رسول الله ! تضحك أن قتل رجل من قومك
~~رجلا من قومنا ؟ قال : فذكره .
# 33624 - مرحبا بالراكب المهاجر ! مرحبا بالراكب المهاجر .
# % ( ت وضعفه ، وابن سعد ، ك - عن عكرمة بن أبي جهل ) .
# 33625 - يأتيكم عكرمة بن أبي جهل مؤمنا مهاجرا فلا تسبوا أباه ، فإن سب
~~الميت يؤذي الحي ولا يبلغ الميت .
# % ( الواقدي وابن سعد وابن عساكر - عن عبد الله بن الزبير ) .
# | 1 ( حرف الفاء ) 1
#
# | 1 ( فرات بن حيان رضي الله عنه ) 1
# 33626 - إن منكم رجالا لا أعطيهم شيئا ، أكلهم إلى إيمانهم ، منهم فرات
~~بن حيان .
# % ( حم ، ه ، ك ، هق - عن فرات ms4535 ) ( أخرجه أبو داود كتاب الجهاد باب
~~الجاسوس الذمي رقم ( 2652 ) ص ) .
# | 1 ( فاتك بن فاتك رضي الله عنه ) 1
#
# | 1 ( { الإكمال } من فاتك بن فاتك رضي الله عنه ) 1
# 33627 - اللهم ! بارك على آل فاتك كما آوى هذا المصاب .
# % ( أبو عبيدة ( أورد الحديث ابن الأثير في أسد الغابة ( 4 / 348 ) ص )
~~وابن عساكر - عن أيوب ) قال : نبئت أن رسول الله صلى الله عليه وسلم أتى
~~على رجل قد قطعت يده في سرقة وهو في فسطاط فقال : من آوى هذا المصاب ؟ ؟
~~قالوا : فاتك بن فاتك أو خزيمة بن فاتك ، قال : فذكره .
# | 1 ( حرف القاف ) 1
#
# | 1 ( قيس بن سعد بن عبادة ( يكنى أبا الفضل وتوفي سنة تسع وخمسين . أسد
~~الغابة ( 4 / 426 ) ص ) رضي الله عنه من الإكمال ) 1
# 33628 - إن الجود لمن شيمة أهل ذلك البيت .
# % ( أبو بكر في الغيلانيات وابن عساكر - عن جابر بن عبد الله ) أن رسول
~~الله صلى الله عليه وسلم بعث بعثا عليهم قيس بن سعد بن عبادة فجهدوا فنحر
~~لهم قيس تسع ركائب فلما قدموا ذكروا ذلك لرسول الله صلى الله عليه وسلم
~~فقال : فذكره ( وابن عساكر عن جابر بن سمرة أيضا ) .
# | 1 ( قضاعة بن معدويه رضي الله عنه ) 1
# 33629 - قضاعة بن معدويه كان يكنى .
# % ( ابن السني - عن عائشة ) .
# | 1 ( قبيصة بن المخارق رضي الله عنه من الإكمال ) 1
# 33630 - يا قبيصة ! ما مررت بحجر ولا شجر ولا مدر إلا استغفر لك ، يا
~~قبيصة ! إذا صليت الفجر فقل ثلاثا : سبحان الله العظيم وبحمده ، تعافى من
~~العمى والجذام
# PageV11P339 والفالج ، يا قبيصة ! قل : اللهم ! إني أسألك مما عندك فأفض
~~علي من فضلك ، وانشر علي من رحمتك ، وأنزل علي من بركاتك .
# % ( حم - عن قبيصة بن المخارق ) ( عداده في أهل البصرة ويكنى أبا بشر .
~~أسد الغابة ( 4 / 384 ) . والحديث في مسند الإمام أحمد بن حنبل . ( 6 / 60
~~) ص ) .
# | 1 ( حرف الميم ) 1
#
# | 1 ( معاذ بن جبل رضي الله عنه ) 1
# 33631 - دع عنك معاذا ، فإن الله يباهي به ms4536 الملائكة .
# % ( الحكيم عن معاذ ) ( توفي في طاعون عمواس سنة ( 18 ) ه وكان عمره ( 38
~~) . راجع أسد الغابة ( 5 / 197 ) وراجع المستدرك ( 3 / 268 ) ص ) .
# 33632 - إذا حضرت العلماء ربهم يوم القيامة كان معاذ بن جبل بين أيديهم
~~بقذفة حجر .
# % ( ابن عساكر - عن عمر ) .
# 33633 - إن العلماء إذا حضروا ربهم كان معاذ بن جبل بين أيديهم رتوة (
~~رتوة : وفي حديث معاذ ( أنه يتقدم العلماء يوم القيامة برتوة ) أي برمية
~~سهم . النهاية ( 2 / 195 ) ب ) بحجر .
# % ( حل - عن عمر ) ( أخرجه أبو نعيم في الحلية ( 1 / 228 ) ص ) .
# 33634 - معاذ بن جبل أعلم الناس بحلال الله وحرامه .
# % ( حل - عن أبي سعيد ) .
# 33635 - معاذ بن جبل أمام العلماء يوم القيامة برتوة .
# % ( طب ، حل عن محمد بن كعب مرسلا ) .
# | 1 ( { الإكمال } من معاذ بن جبل رضي الله عنه ) 1
# 33636 - معاذ بن جبل أعلم الأولين والآخرين بعد النبيين والمرسلين وإن
~~الله تعالى يباهي به الملائكة .
# % ( ك وتعقب - عن أبي عبيدة وعبادة ابن الصامت معا ) .
# 33637 - معاذ بن جبل بين يدي العلماء طائفة يوم القيامة .
# % ( حل عن عمر ) .
# 33638 - معاذ بين يدي العلماء يوم القيامة رتوة .
# % ( ش - عن محمد ابن عبيدة الله الثقفي مرسلا ) .
# 33639 - معاذ بين يدي العلماء نبذة ( نبذة : وجلس نبذة - بضم النون
~~وفتحها - أي : ناحية . المختار ( 510 ) ب ) .
# % ( ش - عن الحسن مرسلا ) .
# 33640 - إن معاذ بن جبل يحشر يوم القيامة بين يدي العلماء نبذة .
# % ( حم - عن عمران ) .
# 33641 - معاذ بن جبل أمام العلماء يوم القيامة ، لا يحجبه من الله إلا
~~المرسلون ، وإن سالما مولى أبي حذيفة شديد الحب لله ، لو لم يخف الله ما
~~عصاه .
# % ( الديلمي - عن عمر ) .
# 33642 - يأتي معاذ بن جبل يوم القيامة بين يدي العلماء برتوة .
# % ( ابن عساكر - عن عمر ؛ ابن سعد - عن محمد بن كعب القرظي مرسلا وعن ابن
~~عون مرسلا وعن الحسن مرسلا ) .
# PageV11P340
# 33643 - آمن كل شيء من معاذ حتى خاتمه .
# % ( ابن سعد - عن محمد ابن عبد الله بن عمر بن عثمان ) .
# | 1 ( ماعز رضي الله عنه ( ماعز ms4537 بن مالك الأسلمي معدود في المدنيين . أسد
~~الغابة ( 5 / 8 ) . والحديث أخرجه مسلم كتاب الحدود رقم ( 1695 ) ص ) . ) 1
# 33644 - استغفروا لماعز بن مالك ، لقد تاب توبة لو قسمت بين أمة لوسعتهم
~~.
# % ( م ، د ، ن - عن بريدة ) .
# 33645 - لا تسبوا ماعزا .
# % ( طب - عن أبي الطفيل ) .
# | 1 ( { الإكمال } من ماعز رضي الله عنه ) 1
# 33646 - إن ماعزا البكائي أسلم آخر قومه وإنه لا تجني عليه الأيدي .
# % ( ابن سعد ، طب - عن عبد الرحمن بن ماعز ) ( ماعز أبو عبد الله بن ماعز
~~وأورد الحديث ابن الأثير في أسد الغابة ( 5 / 8 ) وهذا غير ماعز بن مالك
~~المتقدم الذكر ص ) .
# 33647 - لقد رأيته يتخضخض في أنهار الجنة - يعني ماعزا .
# % ( أبو عوانة ، حب ، ص - عن جابر ) .
# 33648 - والذي نفسي بيده ! إنه لفي نهر من أنهار الجنة ينغمص فيه - يعني
~~ماعزا فقال هزال : أنا أمرته أن يأتيك يا رسول الله ! قال : لو سترته
~~بملحفتك كان خيرا .
# % ( ابن عساكر - عن أبي هريرة ) ( آخر فقرة من الحديث هي في سنن أبي داود
~~كتاب الحدود باب في الستر على أهل الحدود رقم ( 4377 ) ص ) .
# | 1 ( مالك بن سنان رضي الله عنه ) 1
# ( مالك بن سنان والد أبي سعيد الخدري قتل يوم أحد شهيدا . أسد الغابة ( 5
~~/ 27 ) وأورد الحديث .
# والحديث كذلك في المستدرك ( 3 / 563 ) وقال الذهبي : إسناده مظلم ص ) من
~~الإكمال
# 33649 - من أحب أن ينظر إلى من خالط دمي دمه فلينظر إلى مالك بن سنان .
# % ( البغوي ، طب ، ك وتعقب - عن أبي سعيد ) .
# | 1 ( مصعب بن عمير رضي الله عنه من الإكمال ) 1
# 33650 - انظروا إلى هذا الذي نور الله قلبه ، لقد رأيته بين أبوين
~~يغذوانه بأطيب الطعام والشراب ، ولقد رأيت عليه حلة شراها بمائة درهم فدعاه
~~حب الله وحب رسوله إلى ما ترون .
# % ( حل - عن عمر ؛ ق ، كر - عن ابن عمر ) قال : نظر النبي صلى الله عليه
~~وسلم إلى مصعب بن عمير مقبلا وعليه إهاب كبش قد تنطق به فقال : فذكره .
# 33651 - لقد رأيت هذا - يعني مصعب ms4538 بن عمير - عند أبويه بمكة يكرمانه
~~وينعمانه وما فتى من فتيان قريش مثله ، ثم خرج من ذلك ابتغاء مرضاة الله
~~تعالى ونصرة رسوله ، أما ! إنه لا يأتي عليكم إلا كذا وكذا حتى يفتح عليكم
~~فارس والروم فيغدوا أحدكم في حلة ويروح في حلة أخرى ويغدى عليكم بقصعة
~~ويراح عليكم بأخرى ، قالوا : يا رسول الله ! نحن اليوم خير أو ذلك اليوم ؟
~~قال : بل أنتم اليوم خير ، أما ! لو تعلمون من الدنيا ما أعلم لاستراحت
~~أنفسكم منها .
# % ( ك - عن الزبير ) ( أخرجه الحاكم في المستدرك ( 3 / 629 ) وسكت عنه
~~وكذا الذهبي ص ) .
# PageV11P341
# | 1 ( معاوية بن أبي سفيان ( معاوية بن صخر بن أبي سفيان أسلم هو وأبوه
~~وأخوه يزيد وأمه هند يوم فتح مكة وتوفي معاوية سنة ستين وهو ابن ثمان
~~وسبعين سنة وذكر ابن الأثير في أسد الغابة ( 5 / 209 / 212 ) الأحاديث ص )
~~رضي الله عنه من الإكمال ) 1
# 33652 - يبعث الله معاوية يوم القيامة وعليه رداء من نور الإيمان .
# % ( ابن عساكر - عن ابن عمر ؛ حب في الضعفاء ومحمد بن الحسين الرازي في
~~فوائده وابن عساكر والرافعي - عن حذيفة ؛ وأورده ابن الجوزي في الموضوعات )
~~.
# 33653 - يا معاوية ! إن وليت أمرا فاتق الله واعدل .
# % ( حم وابن سعد ، ع وابن عساكر - عن معاوية ) .
# 33654 - يا معاوية ! إن ملكت فأحسن .
# % ( طب ، ق في الدلائل وابن عساكر - عن معاوية ؛ وفيه إسماعيل بن إبراهيم
~~بن مهاجر ؛ قال ق : ضعيف إلا أن للحديث شواهد ) .
# 33655 - إن معاوية لا يصارع أحدا إلا صرعه معاوية .
# % ( الديلمي عن ابن عباس ) .
# 33656 - اللهم علم معاوية الكتاب والحساب وقه العذاب .
# % ( حم ، ع ، طب وأبو نعيم - عن العرباض بن سارية ؛ الحسن بن سفيان
~~والحسن بن عرفة في حزبه والبغوي وابن قانع وأبو نعيم ، كر - عن الحارث بن
~~زياد ؛ عد ، كر - عن ابن عباس ؛ طس ، طب وتمام - عن عبد الله بن أبي عميرة
~~المزني ؛ ابن الجوزي في الواهيات - عن أبي هريرة ) .
# 33657 - اللهم ! علمه الكتاب والحساب ومكن له في البلاد وقه العذاب -
~~قاله لمعاوية .
# % ( ابن سعد ms4539 ، طب وابن عساكر - عن مسلمة ابن مخلد ) .
# 33658 - اللهم ! علمه العلم واجعله هاديا مهديا واهده واهد به قاله
~~لمعاوية .
# % ( حم ، ت ( أخرجه الترمذي كتاب المناقب رقم ( 3824 ) وقال : حسن صحيح ص
~~) : حسن غريب ، طس ، حل وتمام وابن عساكر عن عبد الرحمن بن أبي عميرة
~~المزني ؛ ابن عساكر - عن عمر ) .
# | 1 ( المغيرة أبو سفيان بن الحارث رضي الله عنه من الإكمال ) 1
# 33659 - أبو سفيان بن الحارث خير أهلي .
# % ( طب ، ك - عن أبي حبة البدري ) ( أبو سفيان بن الحارث بن عبد المطلب
~~اسمه المغيرة توفي سنة ( 20 ) وصلى عليه عمر بن الخطاب . المستدرك ( 3 /
~~255 ) . والحديث كذلك أخرجه الحاكم في المستدرك ( 3 / 255 ) وقال : صحيح ،
~~وأقره الذهبي ص ) .
# | 1 ( حرف النون ) 1
#
# | 1 ( نعمان بن بشير رضي الله عنه ) 1
# 33660 - أما ترضى أن يبلغ ما بلغت ثم يأتي الشام فيقتله منافق من أهل
~~الشام .
# % ( ابن سعد - عن عبد الملك بن عمير ) أن بشير بن سعد جاء بالنعمان بن
~~بشير إلى النبي صلى الله عليه وسلم فقال : يا رسول الله ! ادع لابني هذا
~~قال : فذكره .
# | 1 ( نعيم بن سعد رضي الله عنه ) 1
# 33661 - دخلت الجنة فسمعت نجمة من نعيم .
# % ( ابن سعد - عن أبي بكر العدوي مرسلا ) .
# PageV11P342
# | 1 ( نعيمان رضي الله عنه من الإكمال ) 1
# 33662 - لا تقولوا لنعيمان إلا خيرا ، فإنه يحب الله ورسوله .
# % ( ابن سعد - عن أيوب بن محمد مرسلا ) ( النعيمان بن عمرو بن رفاعة
~~وتوفي في خلافة معاوية وذكر ابن سعد في الطبقات ( 3 / 494 ) الحديث . ص ) .
# | 1 ( حرف الواو ) 1
#
# | 1 ( وحشي بن حرب الحبشي رضي الله عنه من الإكمال ) 1
# 33663 - يا وحشي ! اغز وقاتل في سبيل الله كما قاتلت لتصد عن سبيل الله .
# % ( طب - عن وحشي ) ( وحشي بن حرب الحبشي أبو دسمة وهو من سودان مكة .
~~أسد الغابة ( 5 / 438 ) ص ) .
# | 1 ( حرف الهاء ) 1
#
# | 1 ( هبار بن الأسود رضي الله عنه من الإكمال ) 1
# 33664 - قد عفوت عنك وقد أحسن الله بك حيث هداك ms4540 للإسلام والإسلام يجب ما
~~قبله - قاله لهبار بن الأسود ) .
# % ( الواقدي وابن عساكر عن سعيد بن محمد جبير بن مطعم عن أبيه عن جده ) (
~~هبار بن الأسود بن المطلب بن أسد ، أسلم بعد الفتح وذكر الحديث في أسد
~~الغابة ( 5 / 385 ) ص ) .
# | 1 ( هشام وعمرو ابنا العاص رضي الله عنه ) 1
# 33665 - ابنا العاصي مؤمنان : هشام وعمرو .
# % ( ابن سعد ، حم ، ك ، طب - عن أبي هريرة ) .
# | 1 ( حرف الياء ) 1
#
# | 1 ( ياسر بن سويد رضي الله عنه من الإكمال ) 1
# 33666 - اللهم ! أكثر رجالهم وأقل أيامهم ولا تحوجهم ولا تر أحدا بهم
~~خصاصة .
# % ( طب - عن ياسر بن سويد ) ( ياسر بن سويد الجهني والد مسرع ، وأورد
~~الحديث ابن الأثير في أسد الغابة ( 5 / 467 ) ص ) .
# | 1 ( يحيى بن خلاد رضي الله عنه من الإكمال ) 1
# 33667 - لأسمينه اسما لم يسم به بعد يحيى بن زكريا .
# % ( ابن سعد عن إسحاق بن عبد الله ) قال حدثني من سمع علي بن خلاد قال :
~~لما ولد يحيى بن خلاد أتى النبي صلى الله عليه وسلم فحنكه وقال : فذكره (
~~يحيى بن خلاد بن رافع الأنصاري وذكر في أسد الغابة ( 5 / 471 ) الحديث ص )
~~.
# | 1 ( أبو كاهل رضي الله عنه من الإكمال ) 1
# 33668 - يا أبا كاهل ! ألا أخبرك بقضاء قضاه الله على نفسه ؟ أحيى الله
~~قلبك ولا يميته حتى تموت بذلك ، اعلم يا أبا كاهل ! أنه لن يغضب رب العزة
~~على من كان في
# PageV11P343 قلبه مخافة ، ولا تأكل النار منه هدبة ، إنه من قلت حسناته
~~وعظمت عليه سيئاته كان حقا على الله أن يثقل ميزانه يوم القيامة .
# % ( هب - عن أبي كاهل ) ( أبو كاهل الأحمسي ويقال البجلي . أسد الغابة (
~~6 / 260 ) ص ) .
# | 1 ( أبو مالك الأشعري رضي الله عنه من الإكمال ) 1
# 33669 - اللهم ! صل على عبيد أبي مالك واجعله فوق كثير من الناس .
# % ( حم - عن أبي مالك الأشعري ) ( أبو مالك الأشعري قدم في السفينة مع
~~الأشعريين واختلف في اسمه ؛ فقيل كعب بن مالك وقيل عبيد . أسد الغابة ( 6 ms4541 /
~~272 ) ص ) .
# | 1 ( فضائل الصحابة مجتمعة من ثلاثة إلى عشرة فصاعدا ) 1
#
# | 1 ( { الإكمال } من فضائل الصحابة مجتمعة من ثلاثة إلى عشرة فصاعدا ) 1
# 33670 - أبو بكر أرأف أمتي وأرحمها ، وعمر بن الخطاب خير أمتي وأعدلها ،
~~وعثمان بن عفان أحيا أمتي وأكرمها ، وعلي بن أبي طالب ألب أمتي وأشجعها ،
~~وعبد الله بن مسعود أبر أمتي وآمنها ، وأبو ذر أزهداها وأصدقها ، وأبو
~~الدرداء أعبد أمتي وأتقاها ، ومعاوية بن أبي سفيان أحلم أمتي وأجودها .
# % ( عق ، كر وضعفه - عن شداد بن أوس ؛ وأورده ابن الجوزي في الموضوعات )
~~.
# 33671 - أتاني جبريل فقال : يا محمد ! إن الله يحب من أصحابك ثلاثة
~~فأحبهم : علي وأبو ذر والمقداد بن الأسود ، يا محمد ! إن الجنة تشتاق إلى
~~ثلاثة من أصحابك : علي وعمار وسلمان .
# % ( ع - عن محمد بن علي بن الحسين عن أبيه عن جده ؛ قال ابن كثير : فيه
~~نكارة شديدة ولا يصح ) .
# 33672 - اشتاقت الجنة إلى أربعة : علي وسلمان وأبي ذر وعمار بن ياسر .
# % ( كر - عن حذيفة ) ( وهكذا أخرجه أبو نعيم في الحلبة ( 1 / 190 ) . ص )
~~.
# 33673 - ألا ! إن الجنة اشتاقت لأربعة من أصحابي : علي والمقداد وسلمان
~~وأبي ذر .
# % ( طب - عن علي ) .
# 33674 - ثلاثة تشتاث إليهم الحور : علي وعمار وسلمان .
# % ( طب عن أنس ) .
# 33675 - نزل علي الروح الأمين فحدثني أن الله يحب أربعة من أصحابي : [
~~فقال له من حضر من هم يا رسول الله ؟ فقال : ] ( أخرجه أبو نعيم في الحلبة
~~( 1 / 190 ) وما بين الحاصرين استدركته منه ص ) علي وسلمان وأبو ذر
~~والمقداد .
# % ( حل وابن عساكر - عن أبي بريدة عن أبيه ) .
# 33676 - أنا سابق العرب إلى الجنة ، وسلمان سابق فارس إلى الجنة وصهيب
~~سابق الروم إلى الجنة ، وبلال سابق الحبشة إلى الجنة .
# % ( طب وابن أبي حاتم في العلل وابن عساكر ، ص - عن أبي أمامة ) .
# 33677 - أما أنت يا جعفر فأشبه خلقك خلقي وأشبه خلقي وأنت مني وشجرتي ،
~~وأما أنت يا علي فختني وأبو ولدي وأنا منك وأنت مني ، واما أنت يا زيد
~~فمولاي ومني
# PageV11P344 وإلي وأحب القوم إلي ms4542 .
# % ( حم ، طب والبغوي ، ك ( أخرجه الحاكم في المستدرك ( 3 / 217 ) وقال :
~~صحيح وأقره الذهبي ص ) ، ض - عن محمد بن أسامة بن زيد عن أبيه ) .
# 33678 - اكتم علي يا عبادة حياتي : أحب أصحابي إلي أبو بكر ثم عمر ثم علي
~~، قال : ثم من ؟ قال : من عسى أن يكون بعد هؤلاء الزبير وطلحة وسعد وأبو
~~عبيدة ومعاذ وأبو طلحة وأبو أيوب وأنت يا عبادة وأبي بن كعب وأبو الدرداء
~~وابن مسعود وابن عوف وابن عفان ، ثم هؤلاء الرهط من الموالي سلمان وصهيب
~~وبلال وسلمان مولى أبي حذيفة هؤلاء خاصتي ، وكل أصحابي علي كريم حبيب إلي
~~وإن كان عبدا حبشيا .
# % ( الهيثم بن كليب ، طب ، كر - عن عبادة بن الصامت ؛ قال الذهبي : هذا
~~حديث باطل ) .
# 33679 - اقتدوا باللذين من بعدي : أبي بكر وعمر ، واهتدوا بهدي عمار ،
~~وتمسكوا بعهد ابن أم عبد .
# % ( الروياني ، ك ، ق - عن حذيفة ؛ عد ، كر - عن أنس ) ( أخرجه الحاكم في
~~المستدرك ( 3 / 75 ) وقال : صحيح وأقره الذهبي ص ) .
# 33680 - إن الله اصطفى العرب من جميع الناس ، واصطفى قريشا من العرب ،
~~واصطفى بني هاشم من قريش ، واصطفاني واختارني في نفر من أهل بيتي علي وحمزة
~~وجعفر والحسن والحسين .
# % ( ابن عساكر - عن حبشي بن جنادة ) .
# 33681 - إن أرأف الناس بهذه الأمة أبو بكر ، وإن اقواها في دين الله عمر
~~، وإن أصدقها حياء عثمان ، وإن أعلمها بفصل القضاء علي ، وإن أقرأها أبي ،
~~وإن أفرضها زيد ، وإن أعلمها بالناسخ والمنسوخ معاذ ، وإن لكل أمة أمينا
~~وأمين هذه الأمة أبو عبيدة بن الجراح .
# % ( ابن عساكر - عن أبي محجن ؛ وفيه ابن سعد الأعور البقال ) .
# 33682 - أنا سيد ولد آدم ولا فخر ، وآدم تحت لوائي يوم القيامة ولا فخر ،
~~وأبوك سيد كهول العرب ، وعلي سيد شباب العرب ، والحسن والحسين سيدا شباب
~~أهل الجنة إلا ابني الخالة يحيى وعيسى .
# % ( ابن عساكر عن عائشة ) .
# 33683 - أول من يشرب من حوضي صهيب الرومي ، وأول من يأكل ثمر الجنة أبو
~~الدحداح ، وأول من يصافحه الملائكة في مفازة القيامة أبو الدرداء .
# % ( الديلمي - عن ms4543 ابن عباس ) .
# 33684 - اللهم ! صل على أبي بكر فإنه يحبك ويحب رسولك ، اللهم ! صل على
~~عمر فإنه يحبك ويحب رسولك ، اللهم ! صل على عثمان فإنه يحبك ويحب رسولك ،
~~اللهم ! صل على أبي عبيدة بن الجراح فإنه يحبك ويحب رسولك ، اللهم ! صل على
~~عمرو بن العاص فإنه يحبك ويحب رسولك .
# % ( ابن عساكر - عن ابن يخامر السكسكي مرسلا ؛ وفيه انقطاع ) .
# 33685 - خذوا القرآن من أربعة من عبد الله بن مسعود وسالم مولى أبي حذيفة
~~، ومن أبي بن كعب ، ومن معاذ بن جبل ، لقد هممت أن أبعثهم كما بعث عيسى ابن
~~مريم
# PageV11P345 الحواريين ، قالوا : يا رسول الله أفلا تبعث أبا بكر وعمر
~~فهما أعلم وأفضل ؟ فقال : إني لا غنى بي عنهما ، إنهما بمنزلة السمع والبصر
~~وبمنزلة العينين من الرأس .
# % ( ابن عساكر عن ابن عمر ) .
# 33686 - قالت الجنة : يا رب ! زينتني فأحسنت أركاني ، فأوحى الله إليها :
~~قد حشوت أركانك بالحسن والحسين والسعود من الأنصار ، وعزتي ! لا يدخلك مراء
~~ولا بخيل .
# % ( أبو موسى المديني - عن ابن عباس ؛ بزيغ الأزدي - عن أبيه ؛ وقال :
~~غريب ) .
# 33687 - ما من نبي إلا له نظير من أمتي ، وأبو بكر نظير إبراهيم وعمر
~~نظير موسى ، وعثمان نظير هارون ، وعلي بن أبي طالب نظيري ؛ ومن سره أن ينظر
~~إلى عيسى ابن مريم فلينظر إلى أبي ذر الغفاري .
# % ( ابن عساكر - عن أنس ) .
# 33688 - نعم عبد الله أبو بكر ! نعم عبد الله عمر ! نعم عبد الله أبو
~~عبيدة ! نعم عبد الله معاذ ! نعم عبد الله أبي بن كعب ! نعم عبد الله ثابت
~~بن قيس .
# % ( ابن عساكر - عن جابر ؛ وقال : غريب والمحفوظ حديث أبي هريرة ) .
# 33689 - يبعث الله الأنبياء يوم القيامة على الدواب ، ويبعث صالحا على
~~ناقته كيما يوافي بالمؤمنين من أصحابه المحشر ، ويبعث فاطمة والحسن والحسين
~~على ناقتين من نوق الجنة وعلي بن أبي طالب على ناقتي وأنا على البراق ،
~~ويبعث بلال على ناقة فينادي بالأذان وشاهده حقا حقا حتى إذا بلغ أشهد أن
~~محمدا رسول الله شهد بها جميع الخلائق من المؤمنين من ms4544 الأولين والآخرين ،
~~فقبلت ممن قبلت منه .
# % ( طب وأبو الشيخ ، ك وتعقب والخطيب وابن عساكر - عن أبي هريرة ) .
# 33690 - ما من نبي إلا قد أعطي سبعة وزراء نجباء رفقاء ، وأعطيت أنا
~~أربعة عشر وزيرا نقيبا نجيبا - سبعا من قريش : علي والحسن والحسين وحمزة
~~وجعفر وأبو بكر وعمر ، وسبعة من المهاجرين : عبد الله ابن مسعود وسلمان
~~وأبو ذر وحذيفة وعمار ومقداد وبلال .
# % ( حم ، تمام وابن عساكر - عن علي ) .
# 33691 - إنه لم يكن نبي قبلي إلا أعطي سبعة رفقاء نجباء وزراء ، وإني قد
~~أعطيت أربعة عشر : حمزة وجعفر وعلي والحسن والحسين وأبو بكر وعمر ، وعبد
~~الله بن مسعود وأبو ذر والمقداد وحذيفة وعمار وبلال [ وسلمان ] وصهيب .
# % ( خيثمة الأطرابلسي في فضائل الصحابة ، حل - عن علي ) ( في الحلية لأبي
~~نعيم ( 1 / 128 ) موجود ( سلمان ) بدل من صهيب . وما بين الحاصرين أي اسم :
~~سلمان زيادة من الحلية . ص ) .
# 33692 - إن بمكة لأربعة نفر من قريش أربأ ( أي يحفظهم من عدوهم والاسم
~~الربيئة . . . ) . النهاية في غريب الحديث ( 2 / 179 ) ص ) بهم عن الشرك
~~وأرغب لهم في الإسلام : عتاب بن أسيد وجبير بن مطعم وحكيم بن حزام وسهيل بن
~~عمرو .
# % ( ابن عساكر - عن ابن عباس ) .
# PageV11P346
# | 1 ( المجلد الثاني عشر ) 1
#
# | 1 ( الباب الرابع في القبائل وذكرهم مجتمعة ومتفرقة ) 1
#
# | 1 ( الأنصار ) 1
# 33693 - ؟ ؟ حديث ناقص ، يلزم مراجعة الكتاب ؟ ؟
# %
# 33694 - أما بعد أيها الناس ! فإن الناس يكثرون وتقل الأنصار حتى يكونوا
~~في الناس بمنزلة الملح في الطعام ، فمن ولي منكم أمرا يضر فيه أحدا أو ينفع
~~فيه أحدا فليقبل من محسنهم ويتجاوز عن مسيئهم .
# % ( خ ( أخرجه البخاري كتاب الفضائل باب قول النبي صلى الله عليه وسلم
~~اقبلوا من محسنهم ( 5 / 43 ) ص ) - عن ابن عباس ) .
# 33695 - إن الأنصار قد قضوا الذي عليهم وبقي الذي عليكم ، فاقبلوا من
~~محسنهم وتجاوزوا عن مسيئهم .
# % ( الشافعي ، هق في المعرفة - عن أنس ) .
# 33696 - إن الناس يهاجرون إليكم ولا تهاجرون إليهم ، فوالذي نفسي بيده !
~~لا يحب الأنصار رجل حتى يلقى الله إلا لقي الله وهو ms4545 يحبه ، ولا يبغض
~~الأنصار رجل حتى يلقى الله إلا لقي الله وهو يبغضه .
# % ( حم ، طب - عن الحارث بن زياد الأنصاري ) .
# 33697 - إن قريشا حديث عهدهم بجاهلية ومصيبة وإني أردت أن أجبرهم
~~وأتألفهم ، أما ترضون أن يرجع الناس بالدنيا وترجعون برسول الله صلى الله
~~عليه وسلم إلى بيوتكم ! لو سلك الناس واديا أو شعبا ( شعبا : الشعب بالكسر
~~: الطريق ، وقيل : الطريق في الجبل والجمع شعاب . المصباح . انتهى . ( 1 /
~~427 ) . ب ) [ وسلكت الأنصار واديا أو شعبا ] لسلكت وادي الأنصار وشعبهم .
# % ( ت - عن أنس ) ( أخرجه الترمذي كتاب المناقب رقم 3901 وقال حسن صحيح ص
~~) .
# 33698 - أوصيكم بالأنصار فإنهم كرشي ( كرشي : وفي الحديث ( الأنصار كرشي
~~وعيبتي ) أراد أنهم بطانته وموضع سره وأمانته ، والذين يعتمد عليهم في
~~أموره ، واستعار الكرش والعيبة لذلك ؛ لأن المجتر يجمع علفه في كرشه والرجل
~~يضع ثيابه في عيبته . انتهى . النهاية ( 4 / 163 ) . ب ) وعيبتي وقد قضوا
~~الذي عليهم وبقي الذي لهم ، فاقبلوا من محسنهم وتجاوزوا عن مسيئهم .
# % ( خ - عن أنس ) ( أخرجه البخاري كتاب المناقب باب قول النبي صلى الله
~~عليه وسلم ( 5 / 43 ) ص ) .
# 33699 - ألا ! إن عيبتي التي آوي إليها أهل بيتي ، وإن كرشي الأنصار ،
~~فاعفوا عن مسيئهم واقبلوا من محسنهم .
# % ( ت ( أخرجه الترمذي كتاب المناقب رقم ( 3904 ) وقال حسن ص ) عن أبي
~~سعيد ) .
# 33700 - الأنصار كرشي وعيبتي ، وإن الناس سيكثرون وهم يقلون فاقبلوا من
~~محسنهم وتجاوزوا عن مسيئهم .
# % ( ن - عن أسيد ابن حضير ؛ ق ، ت ( أخرجه الترمذي كتاب المناقب رقم (
~~3907 ) وقال حسن صحيح ص ) ، ن - عن أنس ) .
# 33701 - الأنصار شعار ( شعار : ومنه حديث الأنصار ( أنتم الشعار والناس
~~الدثار ) أي أنتم الخاصة والبطانة ، والدثار : الثوب الذي فوق الشعار .
~~انتهى . النهاية ( 2 / 480 ) . ب ) والناس دثار ، ولو أن الناس استقبلوا
~~واديا أو شعبا واستقبلت الأنصار واديا لسلكت وادي الأنصار ، ولولا الهجرة
~~لكنت امرءا من الأنصار .
# % ( ه - عن سهل ابن سعد ) .
# PageV12P003
# 33702 - ألا أخبركم بخير دور الأنصار ؟ خير دور الأنصار دار بني النجار
~~ثم دار بني عبد الأشهل ثم دار بني ms4546 الحارث بن الخزرج ، ثم دار بني ساعدة ،
~~وفي كل دور الأنصار خير .
# % ( حم ، ق ، ن ، ت - عن أنس ؛ حم ، ق ؛ ت - عن أبي أسيد الساعدي ؛ حم ،
~~ق - عن أبي حميد الساعدي ؛ حم ، م - عن أبي هريرة ) .
# 33703 - لولا الهجرة لكنت امراءا من الأنصار ، ولو سلك الناس واديا أو
~~شعبا لسلكت وادي الأنصار وشعبهم .
# % ( ق - عن أنس ؛ حم ، خ ( أخرجه البخاري كتاب المناقب باب قول النبي صلى
~~الله عليه وسلم لولا الهجرة ( 5 / 38 ) ص ) عن أبي هريرة ) .
# 33704 - لولا الهجرة لكنت امرءا من الأنصار ، ولو سلك الناس واديا أو
~~شعبا لكنت مع الأنصار .
# % ( حم ، ت ، ك - ( أخرجه الترمذي من كتاب الفضائل في فصل الأنصار وقريش
~~رقم ( 3899 وقال حسن صحيح . ص ) عن أبي ) .
# 33705 - لا يبغض الأنصار رجل يؤمن بالله واليوم الآخر .
# % ( م - عن أبي هريرة ؛ حم ، ت ، ن - عن ابن عباس ؛ حم ، حب ، عن أبي
~~سعيد ) .
# 33706 - لا يحب الأنصار إلا مؤمن ولا يبغضهم إلا منافق ، من أحبهم أحبه
~~الله ، ومن أبغضهم أبغضه الله .
# % ( حم ، ق ، ت ، ن - عن البراء ) .
# 33707 - يا معشر الأنصار ! ما حديث أتاني ؟ ألا ترضون أن يذهب الناس
~~بالأموال وتذهبون برسول الله صلى الله عليه وسلم حتى تدخلوه في بيوتكم ؟ لو
~~أخذت الناس شعبا وأخذت الأنصار شعبا لأخذت شعب الأنصار .
# % ( حم ، ق ( أخرجه البخاري كتاب المغازي باب غزوة الطائف ( 5 / 200 ) ؟
~~؟ ص ) ن - عن أنس ) .
# 33708 - يا معشر الأنصار ! ألم أجدكم ضلالا فهداكم الله بي ، وكنتم
~~متفرقين فألفكم الله بي ، وكنتم عالة فأغناكم الله بي ؟ أما ترضون أن يذهب
~~الناس بالشاة والبعير وتذهبون بالنبي إلى رحالكم ؟ ولولا الهجرة لكنت
~~امراءا من الأنصار ، ولو سلك الناس واديا أوشعبا لسلكت وادي الأنصار وشعبهم
~~، الأنصار شعار والناس دثار ، إنكم ستلقون بعدي أثرة فاصبروا حتى تلقوني
~~على الحوض .
# % ( حم ، ق ( أخرجه البخاري كتاب المناقب باب مناقب الأنصار ( 5 / 38 ) ص
~~) ؟ ؟ عن عبد الله بن زيد بن عاصم ) .
# 33709 - يا معشر الأنصار ! إن الله قد أثنى عليكم خيرا في الطهور ms4547 فما
~~طهوركم ؟ قالوا : نستنجي بالماء ، قال : هو ذاك فعليكموه .
# % ( ه ، ك - عن جابر وأبي أيوب وأنس ) .
# 33710 - رحم الله الأنصار وأبناء الأنصار وأبناء أبناء الأنصار .
# % ( ه - عن عمرو بن عوف ) .
# 33711 - لكل نبي تركة وإن تركتي وضيعتي ( وضيعتي : ضيعة الرجل ما يكون
~~منه معاشه كالصنعة والتجارة والزراعة وغير ذلك . انتهى . النهاية ( 3 / 108
~~) . ب ) الأنصار ، فاحفظوني فيهم .
# % ( طس - عن أنس ) .
# 33712 - من أحب الأنصار أحبه الله ، ومن أبغض الأنصار أبغضه الله .
# % ( حم ، تخ - عن معاوية ؛ ه ، حب - عن البراء ) .
# PageV12P004
# 33713 - جزى الله الأنصار عنا خيرا لا سيما عبد الله بن عمرو بن حرام
~~وسعد بن عبادة .
# % ( ع ، حب ، ك - عن جابر ) .
# 33714 - آية الإيمان حب الأنصار ، وآية النفاق بغض الأنصار .
# % ( حم ، ق ، ن - عن أنس ) ( أخرجه البخاري كتاب المناقب باب حب الأنصار
~~( 6 / 38 ) . ص ) .
# 33715 - العلم في قريش والأمانة في الأنصار .
# % ( طب - عن ابن جزء ) .
# 33716 - أحسنوا إلى محسن الأنصار واعفوا عن مسيئهم .
# % ( طب - عن سهل بن سعد وعبد الله بن جعفر معا ) .
# 33717 - استوصوا بالأنصار خيرا .
# % ( حم - عن أنس ) .
# 33718 - حب الأنصار آية الإيمان ، وبغض الأنصار آية النفاق .
# % ( حم - عن أنس ) .
# 33719 - خير الرجال رجال الأنصار ، وخير الطعام الثريد .
# % ( فر - عن جابر ) .
# 33720 - خير ديار الأنصار بنو النجار .
