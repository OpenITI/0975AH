#
# | 1 ( حرف الألف ) 1
#
# | 1 ( أبي بن كعب رضي الله عنه من الإكمال ) 1
# 33140 - إن جبرئيل قد أمرني أن أقرئك { لم يكن الذين كفروا من أهل الكتاب
~~} قاله لأبي .
# % ( حم ، طب وابن قانع وابن مردويه - عن أبي حبة البدري ) ( أورده
~~الهيثمي في مجمع الزوائد ( 9 / 312 ) وقال : رواه أحمد والطبراني وفيه علي
~~بن زيد وهو حسن الحديث وبقية رجاله رجال الصحيح وانظر ترجمته في أسد الغابة
~~( 1 / 63 ms4483 ) : توفي سنة عشرين في خلافة عمر ، وأبي بن كعب بن مالك النجار
~~كان اسمه تيم الله . وراجع الإصابة ( 1 / 26 ) ص ) .
# 33141 - ما أغيرك يا أبي ! إني لأغير منك ، والله أغير مني .
# % ( ابن عساكر - عن أبي ) .
# 33142 - يا أبا المنذر ! إني أمرت أن أعرض عليك القرآن ، قال : يا رسول
~~الله ! وذكرت هناك ؟ قال : نعم باسمك ونسبك في الملأ الأعلى .
# % ( طب ( أورده الهيثمي في مجمع الزوائد ( 9 / 312 ) رواه الكبراني في
~~الأوسط بأسانيد ورجال الرواية وثقوا . ص ) - عن معاذ بن محمد بن أبي بن كعب
~~عن أبيه عن جده عن أبي ) .
# | 1 ( أحنف بن قيس رضي الله عنه من الإكمال ) 1
# 33143 - اللهم اغفر للأحنف بن قيس .
# % ( ك - عن الأحنف ابن قيس ) ( أخرجه الحاكم في المستدرك ( 3 / 614 ) في
~~ترجمة الأحنف بن قيس واسم الأحنف الضحاك ويقال صخر بن قيس وكان أحلم العرب
~~وتوفي في الكوفة سنة سبع وستين . راجع أسد الغابة ( 1 / 69 ) ص ) .
# | 1 ( أسامة بن زيد رضي الله عنه ) 1
# 33144 - من كان يحب الله ورسوله فليحب أسامة بن زيد .
# % ( حم عن عائشة ) ( أسامة بن زيد استعمله النبي صلى الله عليه وسلم وهو
~~ابن ثماني عشرة سنة راجع أسد الغابة ( 1 / 80 ) وتوفي سنة أربع وخمسين .
~~راجع الإصابة ( 1 / 45 ) .
# والحديث أخرجه الحاكم في المستدرك ( 3 / 597 ) وقال صحيح وأقره الذهبي ص
~~) .
# 33145 - أسامة أحب الناس إلي .
# % ( حم ، طب - عن ابن عمر ) .
# 33146 - أحب أهلي إلي من قد أنعم الله عليه وأنعمت عليه أسامة ابن زيد ثم
~~علي بن أبي طالب .
# % ( ت ( أخرجه الترمذي كتاب المناقب باب مناقب أسامة بن زيد رقم ( 3819 )
~~وقال : حسن صحيح ص ) ، ك والضياء - عن أسامة بن زيد ) .
# 33147 - أما والله لو أن أسامة بن زيد جارية حليتها وزينتها حتى أنفقها .
# % ( ابن سعد - عن أبي السفر - مرسلا ) .
# PageV11P298
# 33148 - إن تطعنوا في إمارته فقد كنتم تطعنون في إمارة أبيه من قبل ،
~~وايم الله إن كان لخليقا للإمارة وإن كان لمن أحب الناس إلي وإن ms4484 هذا لمن
~~أحب الناس إلي بعده ، وأوصيكم به فإنه من صالحيكم - يعني أسامة بن زيد .
# % ( حم ، ق ( أخرجه مسلم كتاب فضائل الصحابة باب فضائل زيد بن حارثة رقم
~~( 2426 ) ص ) - عن ابن عمر ) .
# 33149 - من أحبني فليحب أسامة .
# % ( م ( أخرجه مسلم كتاب الفتن باب قصة الجساسة رقم ( 2942 ) ص ) - عن
~~فاطمة بنت قيس ) .
# 33150 - لو كان أسامة جارية لكسوته وحليته حتى أنفقه .
# % ( حم ، ه - عن عائشة ) .
# | 1 ( { الإكمال } من أسامة بن زيد رضي الله عنه ) 1
# 33151 - انكحوا أسامة بن زيد فإنه عربي صليب ( صليب : الصلب والصليب :
~~الشديد ، وكذا الصلب بتشديد اللام . انتهى . الصحاح للجوهري ( 1 / 163 ) ب
~~) .
# % ( كر - عن إسماعيل بن محمد بن سعد مرسلا ) .
# 33152 - إن تطعنوا في إمارته فقد كنتم تطعنون في إمارة أبيه من قبل وايم
~~الله ! إن كان لخليقا للإمارة وإن كان أحب الناس إلي وإن هذا لمن أحب الناس
~~إلي وأوصيكم به فإنه من صالحيكم .
# % ( حم ، خ ، م - عن ابن عمر ) قال : بعث رسول الله صلى الله عليه وسلم
~~بعثا وأمر عليهم أسامة بن زيد فطعن بعض الناس في إمارته - فذكره . مر برقم
~~[ 33148 ] .
# 33153 - ألا ! إنكم تعيبون أسامة وتطعنون في إمارته وقد فعلتم ذلك بأبيه
~~من قبل ، إن كان لخليقا بالإمارة وإن كان لأحب الناس كلهم إلي وإن ابنه هذا
~~من بعده لأحب الناس إلي فاستوصوا به خيرا فإنه من خياركم .
# % ( ابن سعد ، عق - عن ابن عمر ) .
# | 1 ( حرف الباء ) 1
#
# | 1 ( البراء بن مالك رضي الله عنه ) 1
# 33154 - كم من أشعث أغبر ذي طمرين ( طورين : الطمر : الثوب الخلق .
~~النهاية ( 3 / 138 ) ب ) لا يؤبه له لو أقسم على الله لأبره ! منهم البراء
~~بن مالك .
# % ( ت والضياء ( أخرجه الترمذي كتاب المناقب باب مناقب البراء بن مالك
~~رقم ( 3854 ) حسن صحيح ص ) - عن أنس ) .
# | 1 ( { الإكمال } من البراء بن مالك رضي الله عنه ) 1
# 33155 - كم من أشعث أغبر ذي طمرين لا يؤبه له لو أقسم على الله لأبره !
~~منهم البراء بن مالك ms4485 .
# % ( ت حسن غريب ، ص - عن أنس ؛ ورواه ك ، حل : كم من ضعيف متضعف ذي طمرين
~~- إلى آخره ) .
# | 1 ( بلال رضي الله عنه ) 1
# 33156 - خير السودان أربعة : لقمان وبلال والنجاشي ومهجع .
# % ( ابن عساكر - عن الأوزاعي معضلا ) .
# 33157 - أريت الجنة فرأيت امرأة أبي طلحة ، ثم سمعت خشخشة ؟ ؟ أمامي فإذا
~~بلال .
# % ( م - عن جابر ) ( أخرجه مسلم كتاب فضائل الصحابة باب من فضائل أم سليم
~~رقم ( 2457 ) وبلال بن رباح الحبشي مؤذن رسول الله صلى الله عليه وسلم توفي
~~بدمشق سنة عشرين فدفن عند الباب الصغير في مقبرة دمشق وهو ابن بضع وستين
~~سنة المستدرك للحاكم ( 3 / 283 ) وراجع الإصابة ( 1 / 273 ) . ويكنى أبا
~~عبد الكريم . راجع أسد الغابة ( 1 / 243 ) ب ) .
# PageV11P299
# 33158 - يا بلال ! بم سبقتني إلى الجنة ؟ ما دخلت الجنة قط إلا سمعت
~~خشخشتك أمامي ، إني دخلت البارحة الجنة فسمعت خشخشتك أمامي فأتيت على قصر
~~مربع مشرف من ذهب فقلت : لمن هذا القصر ؟ قالوا : لرجل من العرب ، فقلت :
~~أنا عربي ، لمن هذا القصر ؟ قالوا لرجل من أمة محمد ، فقلت : أنا محمد ،
~~لمن هذا القصر ؟ قالوا : لعمر بن الخطاب .
# % ( حم ، ت ، حب ، ك - عن بريدة ) ( أخرجه الترمذي كتاب المناقب باب في
~~مناقب عمر رضي الله عنه رقم ( 3689 ) وقال : صحيح غريب . ص ) .
# 33159 - خير السودان ثلاثة : لقمان وبلال ومهجع .
# % ( ك - عن الأوزاعي عن أبي عمار عن واثلة ) .
# 33160 - مثل بلال كمثل نخلة غدت تأكل من الحلو والمر ثم يمسي حلوا كله .
# % ( الحكيم - عن أبي هريرة ) .
# 33161 - دخلت الجنة فسمعت خشفة ( خشفة : الخشفة - بالسكون - : الحس
~~والحركة . النهاية ( 2 / 34 ) ب ) فقلت ما هذه ؟ قالوا : هذا بلال ، ثم
~~دخلت الجنة فسمعت خشفة فقلت : ما هذه ؟ قالوا : الغميصاء بنت ملحان .
# % ( عبد بن حميد - عن أنس ! الطيالسي - عن جابر ) .
# 33162 - دخلت الجنة فسمعت خشفة بين يدي فقلت : ما هذه الخشفة ؟ فقيل :
~~هذا بلال يمشي أمامك .
# % ( طب ، عد - عن أبي أمامة ) .
# 33163 - دخلت الجنة ليلة أسري بي فسمعت في جانبها وجسا ( وجسا : الوجس :
~~الصوت الخفي . النهاية ( 5 ms4486 / 156 ) ب ) فقلت : يا جبريل ! ما هذا ؟ قال :
~~هذا بلال المؤذن .
# % ( حم ، ع - عن ابن عباس ) .
# | 1 ( { الإكمال } من بلال رضي الله عنه ) 1
# 33164 - إذا كان يوم القيامة حملت على البراق ، وحملت فاطمة على ناقتي
~~القصواء ، وحمل بلال على ناقة من نوق الجنة وهو يقول : الله أكبر الله أكبر
~~- إلى آخر الأذان يسمع الخلائق .
# % ( كر - عن علي ) .
# 33165 - نعم المرء بلال ! ولا يتبعه إلا مؤمن وهو سيد المؤذنين ،
~~والمؤذنون أطول الناس أعناقا يوم القيامة .
# % ( عد ، ه ، طب ، ك ، كر ، حل عن زيد بن أرقم ؛ وفيه حسام بن مصك متروك
~~؛ وأبو الشيخ في الأذان - عن البراء بن عازب ) .
# 33166 - بلال سيد المؤذنين يوم القيامة ، ولا يتبعه إلا المؤذنون ،
~~والمؤذنون أطول الناس أعناقا يوم القيامة .
# % ( ش والديلمي - عن زيد بن أرقم ) .
# 33167 - يجيء بلال يوم القيامة على راحلة رحلها ( رحلها : الراحلة :
~~الناقة التي تصلح لأن ترحل . ورحل البعير : شد على ظهره الرحل ورحل البعير
~~: أصغر من القتب والجمع الرحال . المختار ( 189 ) ب ) من ذهب وياقوت معه
~~لواء يتبعه المؤذنون حتى يدخلهم الجنة حتى إنه ليدخل من أذن أربعين يبتغي
~~بذلك وجه الله .
# % ( ابن عساكر - عن ابن عمر ؛ وفيه أبو الوليد خالد بن إسماعيل المخزومي
~~متروك ، قال عد : كان يضع الحديث على الثقات ) .
# PageV11P300
# 33168 - أريت أني دخلت الجنة فسمعت خشفة بين يدي فقلت : من هذا يا جبريل
~~؟ فقال : بلال المؤذن ، فنظرت فإذا أعالي أهل الجنة فقراء المهاجرين وذراري
~~المؤمنين ، وإذا فيها ليس أحد من الأغنياء والنساء فقلت : ما لي لا أرى
~~فيها أحدا أقل من الأغنياء والنساء ؟ فقال لي : أما الأغنياء فإنهم على
~~الباب يحاسبون ويمحصون ، وأما النساء فألهاهن الأحمران الذهب والحرير ،
~~فخرجنا من أحد الثمانية أبواب ، فإذا أنا بالميزان فوضعت في كفة وأمتي في
~~كفة فرجحت بها ، ثم جيء بأبي بكر فوضع في كفة وأمتي في كفة فرجح بها ، ثم
~~جيء بعمر فوضع في كفة وأمتي في كفة فرجح بها ، ثم جعلوا يعرضون على أمتي
~~رجلا رجلا فاستبطأت عبد الرحمن بن ms4487 عوف فلم أره إلا بعد إياسه ، فلما رآني
~~بكى ، قلت : عبد الرحمن بن عوف ما يبكيك ؟ قال : والذي بعثك بالحق ! ما
~~رأيتك حتى ظننت أني لا أراك أبدا إلا بعد المشيبات ، قلت : وما ذاك ؟ قال :
~~من كثرة مالي مازلت أحاسب بعدك وأمحص .
# % ( حم وهناد والحكيم ، طب ، كر - عن أبي أمامة ؛ وأورده ابن الجوزي في
~~الموضوعات ) .
# 33169 - دخلت الجنة فسمعت خشفة أمامي فقلت : من هذا يا جبريل ؟ فقال :
~~بلال ، فقلت : طوبى لبلال .
# % ( ط ، حل وابن عساكر عن جابر ) .
# 33170 - دخلت الجنة فسمعت خشخشة أمامي فقلت : من هذا ؟ قال : أنا بلال ،
~~قلت : بم سبقتني إلى الجنة ؟ قال : ما أحدثت إلا توضأت وما توضأت إلا رأيت
~~أن لله علي ركعتين ، قال : بها .
# % ( الروياني وابن عساكر - عن أبي أمامة ) .
# 33171 - دخلت الجنة فإذا حس فنظرت فإذا هو بلال .
# % ( طب وابن عساكر - عن سهل بن سعد ) .
# 33172 - بلال سابق الحبشة وصهيب سابق الروم .
# % ( ش وابن عساكر عن الحسن مرسلا ؛ وسنده جيد ) .
# 33173 - ما حدثك عني بلال فقد صدقك ، بلال لا يكذب ، لا تغضبي بلال فلا
~~يقبل منك عمر ما أغضبت بلالا .
# % ( ابن عساكر عن امرأة بلال ) .
# 33174 - يا بلال ! بم سبقتني إلى الجنة ؟ ما دخلت الجنة إلا سمعت خشخشتك
~~أمامي ، إني دخلت البارحة الجنة فسمعت خشخشتك فأتيت على قصر مربع مشرف من
~~ذهب فقلت : لمن هذا القصر ؟ قالوا : لرجل من العرب ، فقلت : أنا عربي ، لمن
~~هذا القصر ؟ قالوا : لرجل من قريش ، فقلت أنا قرشي ، لمن هذا القصر ؟ قالوا
~~: لرجل من أمة محمد ، فقلت : أنا محمد ، لمن هذا القصر ؟ قالوا : لعمر بن
~~الخطاب ، قال بلال : ما أذنت قط إلا صليت ركعتين وما أصابني حدث قط إلا
~~توضأت وصليت ركعتين ، فقال : بهذا .
# % ( حم ، ت : حسن غريب ؛ وابن خزيمة ، حب ، ك - عبد الله ابن بريدة عن
~~أبيه ) . مر برقم [ 33158 ] .
# PageV11P301
# 33175 - يا بلال ! حدثني بأرجى عمل عملته عندك في الإسلام منفعة فإني
~~سمعت الليلة دف نعليك بين يدي في الجنة قال : ما عملت عملا أرجى عندي من
~~أني ms4488 لم أتطهر طهورا في ساعة من ليل أو نهارا إلا صليت بذلك الطهور ما كتب
~~لي أن أصلي .
# % ( حم ، خ ، م - عن أبي هريرة ) ( أخرجه مسلم كتاب فضائل الصحابة باب من
~~فضائل بلال رضي الله عنه رقم ( 2458 ) ص ) .
# 33176 - يا بريدة ! لا يكل بصرك ولا يذهب سمعك ، أنت نور لأهل المشرق .
# % ( ق ، ك في تاريخه - عن بريدة ) .
# | 1 ( بشير بن الخصاصية رضي الله عنه ) 1
# 33177 - يا ابن الخصاصية ! ما أصبحت تنقم ( تنقم : نقم عليه فهو ناقم ،
~~أي : عتب عليه . المختار ( 537 ) ب . ) على الله أصبحت تماشي رسول الله .
# % ( حم ، ه ( بشير بن يزيد بن معبد وكان اسمه : زحما فسماه رسول الله صلى
~~الله عليه وسلم : بشيرا أسد الغابة ( 1 / 229 ) وراجع الاصابة ( 1 / 263 )
~~ص ) - عن بشير بن الخصاصية ) .
# | 1 ( { الإكمال } من بشير بن الخصاصية رضي الله عنه ) 1
# 33178 - يا بشير ! ألا تحمد الله الذي أخذ بناصيتك إلى الإسلام من بين
~~ربيعة قوم يرون أن لولاهم لائتفكت ( لائتفكت : يقال ائتفكت البلدة بأهلها ،
~~أي : انقلبت ، فهي مؤتفكة . انتهى . النهاية ( 1 / 56 ) ب ) الأرض بمن
~~عليها .
# % ( طب ، هق وابن عساكر - عن بشير بن الخصاصية ) .
# | 1 ( حرف الثاء ) 1
#
# | 1 ( ثابت بن الدحداح أبو الدحداح رضي الله عنه ) 1
# 33179 - رب عذق مذلل لابن الدحداحة في الجنة .
# % ( ابن سعد عن ابن مسعود ) .
# 33180 - كم من عذق معلق أو مذلل لأبي الدحداح في الجنة .
# % ( حم ، م ( أخرجه مسلم كتاب الجنائز باب ركوب المصلى رقم ( 965 ) وثابت
~~بن الدحداح . توفي يوم رجع النبي صلى الله عليه وسلم من الحديبية . الإصابة
~~( 3 / 8 ) وأسد الغابة ( 1 / 267 ) ص ) ، د ، ت - عن جابر بن سمرة ) .
# | 1 ( { الإكمال } من ثابت بن الدحداح رضي الله عنه ) 1
# 33181 - كم من عذق رداح ( رداح : وفي حديث ابن عمر في الفتن ( لأكونن
~~فيها مثل الجمل الرداح ) أي الثقيل الذي لا انيعاث ؟ ؟ له . النهاية ( 2 /
~~213 ) ب ) لأبي الدحداح في الجنة .
# % ( حم والبغوي ، حب ، ك ، طب - عن أنس ؛ طب ms4489 - عن عبد الرحمن بن ابزى ) .
# 33182 - كم من عذق معلق أو مذلل لأبي الدحداح في الجنة .
# % ( حم ، م ، د ، ت : حسن صحيح ، حب - عن جابر بن سمرة ) .
# | 1 ( ثابت بن قيس رضي الله عنه من الإكمال ) 1
# 33183 - يا ثابت ! ألا ترضى أن تعيش حميدا ! وتقتل شهيدا وتدخل الجنة .
# % ( ابن سعد والبغوي وابن قانع ، ض - عن محمد بن ثابت ابن قيس بن شماس عن
~~أبيه ) ( ثابت بن قيس الأنصاري الخزرجي خطيب الأنصار وبشره النبي صلى الله
~~عليه وسلم بالجنة راجع أسد الغابة ( 1 / 74 ) والاصابة ( 2 / 14 ) . وقتل
~~يوم اليمامة مشهدا وروى حديثه الحاكم في المستدرك ( 3 / 234 ) : وقال :
~~صحيح وأقره الذهبي . ص ) .
# PageV11P302
# | 1 ( حرف الجيم ) 1
#
# | 1 ( جرير بن عبد الله رضي الله عنه ) 1
# 33184 - جرير بن عبد الله منا أهل البيت ظهر لبطن ظهر لبطن ظهر لبطن .
# % ( عد ، طب وابن عساكر - عن علي ) .
# 33185 - لا تسبوا جرير بن عبد الله ، إن جريرا منا أهل البيت .
# % ( تمام والخطيب وابن عساكر - عن علي ) ( جرير بن عبد الله البجلي :
~~توفي ببلدة قريبة على نهر الفرات تسمى قرقيساء سنة إحدى وخمسين . أسد
~~الغابة ( 1 / 333 ) والحاكم في المستدرك ( 3 / 464 ) وذكر حديثه ابن حجر في
~~الإصابة ( 2 / 77 ) ص ) .
# | 1 ( جعفر بن أبي طالب رضي الله عنه ( جعفر بن أبي طالب : أسلم بعد
~~إسلام أخيه علي وكان عمره لما قتل احدى وأربعين سنة . أسد الغابة ( 1 / 344
~~) والإصابة ( 2 / 86 ) . وترجم له الحاكم في المستدرك ( 3 / 208 ) وقال :
~~قتل بمؤتة في سنة ثمان من الهجرة ص ) . ) 1
# 33186 - دخلت الجنة فإذا جارية أدماء ( أدماء : الأدمة في الإبل : البياض
~~مع سواد المقلتين ، وهي في الناس : السمرة الشديدة . النهاية ( 1 / 32 ) ب
~~) لعساء ( لعساء : يقال : جارية لعساء إذا كان في لونها أدنى سواد وشربة من
~~الحمرة . النهاية ( 4 / 253 ) ب ) فقلت : ما هذه يا جبريل ؟ فقال : إن الله
~~تعالى عرف شهوة جعفر بن أبي طالب للأدم اللعس فخلق له هذه .
# % ( جعفر بن أحمد ms4490 القمى في فضائل جعفر والرافعي في تاريخه - عن عبد الله
~~بن جعفر ) .
# 33187 - على مثل جعفر فلتبك الباكية .
# % ( ابن عساكر - عن أسماء بنت عميس ) .
# 33188 - أسمح أمتي جعفر .
# % ( المحاملي في أماليه وابن عساكر - عن أبي هريرة ) .
# 33189 - رأيت جعفر بن طالب ملكا يطير في الجنة مع الملائكة بجناحين .
# % ( د ، ك - عن أبي هريرة ) ( الحديث في سنن الترمذي كتاب المناقب باب
~~مناقب جعفر رقم ( 3763 ) وقال غريب ص ) .
# 33190 - سيد الشهداء جعفر بن أبي طالب ، معه الملائكة ، لم ينحل ( ينحل :
~~النحل - بالضم - مصدر نحلة ينحله - بالفتح - نحلا ، أي : أعطاه . انتهى .
~~المختار ( 515 ) ب ) ذلك أحد ممن مضى من الأمم غيره شيء أكرم الله به محمدا
~~صلى الله عليه وسلم .
# % ( أبو القاسم الخرقي في أماليه - عن علي ) .
# 33191 - عرفت جعفرا في رفقة من الملائكة يبشرون أهل بيته بالمطر .
# % ( عد - عن علي ) .
# 33192 - دخلت الجنة البارحة فنظرت فيها فإذا جعفر يطير مع الملائكة وإذا
~~حمزة متكئ على سرير .
# % ( طب ، عد ، ك ( أخرجه الحاكم في المستدرك ( 3 / 209 ) ص ) عن ابن عباس
~~) .
# 33193 - استغفروا لأخيكم جعفر فإنه شهيد وقد دخل الجنة وهو يطير فيها
~~بجناحين من ياقوت حيث شاء من الجنة .
# % ( ابن سعد - عن عبد الله ابن أبي بكر بن محمد عمرو بن حزم وعاصم بن عمر
~~بن قتادة مرسلا ) .
# 33194 - إن الله قد جعل لجعفر جناحين مضرجين بالدم يطير بهما مع الملائكة
~~.
# % ( قط في الأفراد ، ك - عن البراء ) .
# PageV11P303
# | 1 ( { الإكمال } من جعفر بن أبي طالب ) 1
# 33195 - أشبه خلقك خلقي وأشبه خلقك خلقي ، فأنت مني ومن شجرتي .
# % ( ابن سعد - عن محمد بن أسامة بن زيد عن أبيه ) .
# 33196 - أشبهت خلقي وخلقي ، وأنت من شجرتي التي أنا منها .
# % ( خط - عن علي ) ( صدر الحديث أخرجه البخاري كتاب الصلح باب كيف يكتب
~~هذا ( 3 / 242 ) والترمذي كتاب المناقب باب مناقب جعفر بن أبي طالب رقم (
~~3765 ) وقال : حسن صحيح ص ) .
# 33197 - أما أنت يا جعفر فأشبهت خلقي وخلقي ، فأنت من شجرتي التي أنا
~~منها ، وأما الجارية ms4491 فأقضي بها لجعفر تكون مع خالتها وإنما الخالة أم .
# % ( ك - عن علي ، وروي د ، ق آخره ) .
# 33198 - أشبهت خلقي وخلقي - قاله لجعفر .
# % ( حم - عن عبيد الله ابن زيد بن أسلم ) .
# 33199 - جعفر أشبه خلقي وخلقي ، وأما أنت يا عبيد الله فأشبه خلق الله
~~بأبيك .
# % ( ابن عساكر - عن عبد الله بن جعفر ) .
# 33200 - خلق الناس من أشجار شتى ، وخلقت أنا وجعفر من طينة واحدة .
# % ( ابن عساكر - عن وهب بن جعفر بن محمد عن أبيه مرسلا ، ووهب كان يضع
~~الحديث ) .
# 33201 - الناس من شجر شتى وخلقت أنا وجعفر من شجرة .
# % ( ابن عساكر - عن عبد الله بن معاوية بن عبد الله بن جعفر عن أبيه عن
~~جده ) .
# 33202 - إن المرء كثير بأخيه وابن أمه ؟ ؟ ، ألا إن جعفرا قد استشهد وقد
~~جعل له جناحان يطير بهما مع الملائكة في الجنة .
# % ( ابن سعد - عن عبد الله بن جعفر ) .
# 33203 - إن جبريل أخبرني أن الله استشهد جعفرا وأن له جناحين يطير بهما
~~مع الملائكة في الجنة .
# % ( طب وأبو نعيم في المعرفة ، كر - عن ابن عباس ) .
# 33204 - إن لجعفر بن أبي طالب جناحين يطير بهما في الجنة مع الملائكة .
# % ( ابن سعد - عن علي ) .
# 33205 - رأيت جعفر بن أبي طالب ملكا يطير في الجنة ذا جناحين يطير بهما
~~حيث شاء مضرجة قوادمه بالدماء .
# % ( الباوردي ، عد ، طب ، كر - عن ابن عباس ) .
# 33206 - لقد مر بي الليلة جعفر بن أبي طالب في ملأ من الملائكة فسلم علي
~~.
# % ( قط في غرائب مالك - عن ابن عمر ؛ وضعف ) .
# 33207 - مر بي جعفر بن أبي طالب الليلة في ملأ من الملائكة له جناحان
~~مضرجان بالدم أبيض القوادم .
# % ( ابن سعد وابن عساكر - عن عبد الله بن جعفر ) .
# PageV11P304
# 33208 - يا أسماء ! هذا جعفر بن أبي طالب مر مع جبريل وميكائيل وإسرافيل
~~فسلم علي وأخبرني أنه لقي المشركين يوم كذا ، قال : فأصبت في جسدي من
~~مقادمي ثلاثا وسبعين من رمية وطعنة وضربة ، ثم أخذت اللواء بيدي اليمنى
~~فقطعت ، ثم أخذته بيدي اليسرى فقطعت ، فعوضني الله بيدي جناحين ms4492 أطير بهما
~~مع جبريل وميكائيل أنزل من الجنة حيث شئت وآكل من ثمارها ما شئت .
# % ( أبو سهل بن زياد القطان في الرابع من فوائده ، ك وابن عساكر - عن ابن
~~عباس ) .
# 33209 - اللهم ! إن جعفرا قد قدم إلى أحسن الثواب فاخلفه في ذريته بأحسن
~~ما خلفت أحدا من عبادك في ذريته .
# % ( الواقدي وابن سعد وابن عساكر - عن عبد الله بن جعفر بن سعد بن عامر )
~~.
# 33210 - اللهم اخلف جعفرا في ولده .
# % ( طب وابن عساكر - عن ابن عباس ؛ حم وابن عساكر - عن عبد الله بن جعفر
~~) .
# 33211 - اللهم اخلف جعفرا في أهله وبارك لعبد الله في صفقة يمينه - ثلاث
~~مرات .
# % ( ط وابن سعد ، حم ، طب ، ك ، وابن عساكر - عبد الله بن جعفر ) .
# 33212 - رأيت كأني دخلت الجنة فرأيت لجعفر درجة فوق درجة زيد فقيل لي :
~~تدري بم رفعت درجة جعفر ؟ قلت : لا ، قيل : لقرابة ما بينك وبينه .
# % ( ك وتعقب - عن ابن عباس ) .
# 33213 - رأيت جعفرا ملكا يطير في الجنة تدمي قادمتاه ورأيت زيدا دون ذلك
~~فقلت : ما كنت أظن أن زيدا دون جعفر ، فقال جبريل : إن زيدا ليس بدون جعفر
~~ولكنا فضلنا جعفرا لقرابته منك .
# % ( ابن سعد عن محمد بن عمر بن علي مرسلا ) .
# 33214 - مثاوالي ؟ ؟ في الجنة في خيمة من درة كل واحد منهم على سرير
~~فرأيت زيدا وابن رواحة أعناقهما صدودا ( صدودا : صد عنه يصد - بضم الصاد -
~~صدودا : أعرض ، وصده عن الأمر : منعه وصرفه عنه ، من باب رد . المختار (
~~283 ) ب ) ، وأما جعفر فهو مستقيم ليس فيه صدود ، فسألت فقيل : إنهما حين
~~غشيهما الموت كأنهما أعرضا أو كأنهما صدا بوجههما ، وأما جعفر فإنه لم يفعل
~~.
# % ( عبد الرزاق ، طب ، حل - عن ابن المسيب مرسلا ) .
# 33215 - ألا أخبركم عن رؤيا رأيتها ؟ دخلت الجنة فرأيت جعفرا ذا جناحين
~~مضرجا بالدماء وزيد مقابله وابن رواحة معهم كأنه معرض عنهم ، وسأخبركم عن
~~ذلك ، إن جعفرا حين تقدم فرأى القتل لم يصرف وجهه وزيد كذلك ، وابن رواحة
~~صرف وجهه .
