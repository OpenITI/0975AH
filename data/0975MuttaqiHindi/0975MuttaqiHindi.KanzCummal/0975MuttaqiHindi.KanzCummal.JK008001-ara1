# 26765 - طهور كل أديم دباغه .
# % ( أبو بكر في الغيلانيات عن عائشة ) .
# 26766 - أيما إهاب دبغ فقد طهر .
# % ( حم ، ت ( أخرجه الترمذي كتاب اللباس باب ما جاء في جلود الميتة إذا
~~دبغت رقم ( 1727 ) قال : حسن صحيح ) ، ن ، ه عن ابن عباس ) .
# 26767 - إذا دبغ الإهاب فقد طهر .
# % ( م د عن ابن عباس ) ( أخرجه مسلم كتاب الحيض باب طهارة جلود الميتة
~~بالدباغ رقم ( 106 و 366 ) ص ) .
# 26768 - إذا دبغ جلد الميتة فحسبه فلينتفع به .
# % ( عب عطاء مرسلا ) .
# 26769 - إن الدباغ يحل من الميتة كما يحل الخل من الخمر .
# % ( عد هق عن أم سلمة ) .
# 26770 - لو أخذتم إهابها يطهره الماء والقرظ .
# % ( د ن ( أخرجه أبو داود كتاب اللباس باب في أهب الميتة رقم ( 4108 )
~~وقال المنذري : أخرجه النسائي . عون المعبود ( 11 / 183 ) ص ) عن ميمونة )
~~.
# 26771 - ما عليها لو انتفعت بإهابها إنما حرم الله أكلها .
# % ( ن عن ميمونة ) .
# 26772 - هلا أخذتم إهابها فدبغتموه فانتفعتم إنما حرم أكلها .
# % ( حم 4 ( أخرجه ms3548 مسلم كتاب الحيض باب طهارة جلود الميتة رقم ( 363 ) ص )
~~عن ابن عباس ) .
# | 1 ( { الإكمال } من الدباغ ) 1
# 26773 - اشربوا فإن دباغ الميتة طهورها .
# % ( البغوي وابن قانع وابن منده ، كر عن جون بن قتادة التيمي قال : كنا
~~مع رسول الله صلى الله عليه وسلم في سفر فمروا بسقاء معلق ، فقال صاحبه :
~~إنه جلد ميتة ، قال النبي صلى الله عليه وسلم : فذكره ) .
# 26774 - أفلا انتفعتم بإهابها يحلها دباغها كما يحل الخل الخمر .
# % ( طب عن أم سلمة ) .
# 26775 - ألا كنتم تنتفعون بإهابها ؟ إن دباغها أحلها كما أحل الخل الخمر
~~.
# % ( طب عن أم سلمة ) .
# 26776 - ألا دبغتم إهابها فاستمتعتم به .
# % ( حب عن ميمونة رضي الله عنها ) .
# 26777 - ما ضر أهل هذه لو انتفعوا بإهابها .
# % ( ه عن سليمان ؛ طب عن أبي مسعود ) .
# PageV09P181
# 26778 - أفلا انتفعتم به فإن دباغها ذكاتها يحل كما يحل الخل من الخمر .
# % ( طب عن أم سلمة ) .
# 26779 - هلا انتفعتم بجلدها إنما حرم أكلها .
# % ( مالك والشافعي ، حم ، خ ، م ( أخرجه مسلم كتاب الحيض باب طهارة جلود
~~الميتة بالدباغ رقم ( 101 ) ص ) ن حب عن ابن عباس قال : وجد النبي صلى الله
~~عليه وسلم شاة ميتة قال : فذكره ) .
# 26780 - جلود الميتة دباغته يذهب خبثه .
# % ( حم ك عن ابن عباس ) .
# 26781 - كل إهاب دبغ فقد طهر .
# % ( ط عن ابن عباس ) .
# 26782 - لا بأس بمسك الميتة إذا دبغ .
# % ( طب عن أم سلمة ) .
# 26783 - دباغه يذهب خبثه .
# % ( حم ك عن ابن عباس ) .
# 26784 - فأين الدباغ ؟
# % ( عم ، ق عن ابن أبي ليلى أن رجلا قال : يا رسول الله أصلي في الفراء
~~قال : فذكره ) .
# 26785 - إنما حرم من الميتة أكل اللحم ، فأما الصوف والشعر والجلد فلا
~~بأس به .
# % ( عد وابن النجار عن ابن عباس ) .
# 26786 - إنما حرم عليكم لحمها ورخص لكم في مسكها .
# % ( طب عن ابن عباس ) .
# 26787 - لا تنتفعوا بشيء من الميتة .
# % ( سمويه عن جابر ، أبو عبد الله الكيساني في فوائده عن ابن عمر ) .
# 26788 - لا تنتفعوا من الميتة بإهاب ولا عصب .
# % ( ط حم عن عبد الله ms3549 بن عكيم ) .
# 26789 - لا تستمتعوا من الميتة بإهاب ولا عصب .
# % ( طس عن عبد الله بن عكيم ) .
