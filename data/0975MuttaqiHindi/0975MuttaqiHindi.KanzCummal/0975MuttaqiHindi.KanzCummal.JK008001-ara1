# | 1 ( حرف الضاد ) 1
#
# | 1 ( ضرار بن الأزور رضي الله عنه ) 1
# 33360 - ما غبنت صفقتك يا ضرار .
# % ( حم - عن ضرار بن الأزور ) ( ضرار بن الأزور بن مرداس كان شاعرا فقال
~~:
# فيا رب لا أغبن صفقتي فقد بعت أهلي ومالي بدالا
# فأجاب النبي صلى الله عليه وسلم : ما غبنت الحديث المذكور في النص . أسد
~~الغابة ( 3 / 51 ) ص ) .
# | 1 ( حرف الطاء ) 1
#
# | 1 ( طلحة بن عبيد الله رضي الله عنه ( طلحة بن عبيد ms4509 الله بن عثمان أبو
~~محمد القرشي التيمي ويعرف بطلحة الخير وطلحة الفياض . توفي سنة ست وثلاثين
~~وعمره ستين سنة . أسد الغابة ( 3 / 88 ) ص ) ) 1
# $ 1 ( { الإكمال }
# 33361 - طلحة شهيد يمشي على وجه الأرض . ) 1 $
# % ( ه - عن جابر ؛ ابن عساكر - عن أبي هريرة وأبي سعيد ) .
# 33362 - لقد رأيتني يوم أحد وما في الأرض قربي مخلوق غير جبريل عن يميني
~~وطلحة عن يساري .
# % ( ك - عن أبي هريرة ) .
# 33363 - طلحة ممن قضى نحبه .
# % ( ت ، ه - عن معاوية ؛ ابن عساكر - عن عائشة ) ( أخرجه الترمذي كتاب
~~المناقب باب مناقب طلحة رقم ( 3738 و 3740 ) وقال : حسن صحيح غريب ص ) .
# 33364 - أوجب طلحة حين صنع برسول الله صلى الله عليه وسلم ما صنع .
# % ( حم ، ت ، حب ، ك - عن ابن الزبير ) ( أخرجه الترمذي كتاب المناقب باب
~~مناقب طلحة رقم ( 3738 و 3740 ) وقال : حسن صحيح غريب ص ) .
# 33365 - لك الجنة علي يا طلحة غدا .
# % ( أبو نعيم في فضائل الصحابة عن عمر ) .
# 33366 - هذا ممن قضى نحبه - يعني طلحة .
# % ( ت - عن طلحة ) ( أخرجه الترمذي كتاب المناقب باب مناقب طلحة رقم (
~~3741 و 3739 ) وقال : غريب ص ) .
# 33367 - لو قلت بسم الله لرفعتك الملائكة والناس ينظرون إليك حتى تلج بك
~~في جو السماء .
# % ( ن - عن جابر ؛ طب - عن طلحة ) .
# 33368 - طلحة والزبير جاراي في الجنة .
# % ( ت ، ك - عن علي ) .
# 33369 - من أحب أن ينظر إلى شهيد يمشي على وجه الأرض فلينظر إلى طلحة بن
~~عبيد الله .
# % ( ت ، ك - عن جابر ) ( أخرجه الترمذي كتاب المناقب باب مناقب طلحة رقم
~~( 3741 و 3739 ) وقال : غريب ص ) .
# | 1 ( { الإكمال } من طلحة ) 1
# 33370 - ما أنت يا طلحة إلا فياض .
# % ( ابن عساكر - عن محمد بن إبراهيم بن الحارث التيمي ) .
# PageV11P318
# 33371 - من أراد أن ينظر إلى شهيد على وجه الأرض فلينظر إلى طلحة بن عبيد
~~الله .
# % ( ك ، وتعقب ، كر - عن جابر ) .
# 33372 - من سره أن ينظر إلى رجل يمشي على ظهر الأرض وقد قضى نحبه فلينظر
~~إلى طلحة .
# % ( ع ، حل وابن عساكر - عن ms4510 عائشة ) .
# 33373 - يا طلحة ! هذا جبريل يقرئك السلام ويقول لك : أنا معك في أهوال
~~القيامة حتى أنجيك منها .
# % ( أبو بكر الشافعي في الغيلانيات والديلمي وابن عساكر - عن عمر ) .
# 33374 - يا طلحة ! أنت ممن قضى نحبه .
# % ( ابن منده وابن عساكر عن أسماء بنت أبي بكر ؛ ابن عساكر - عن عائشة )
~~.
# 33375 - لو قلت بسم الله لرأيت بناءك الذي بنى الله لك في الجنة وأنت في
~~الدنيا .
# % ( قط في الأفراد وابن شاهين في أماليه وأبو نعيم في فضائل الصحابة وابن
~~عساكر - عن طلحة لما أصيبت يده مع رسول الله صلى الله عليه وسلم قال : حس (
~~حس : هي بكسر السين والتشديد كلمة يقولها الإنسان إذا أصابه ما أمضه وأحرقه
~~غفلة . النهاية ( 1 / 385 ) ص ) قال : فذكره .
# 33376 - سلفي في الدنيا والآخرة .
# % ( طب ، ص - عن طلحة ) قال : كان النبي صلى الله عليه وسلم إذا رآني قال
~~- فذكره .
# 33377 - ما صبر معي يوم أحد غير طلحة ، لقد كان يقيني النبل بكفيه .
# % ( الديلمي عن جابر ) .
# | 1 ( طلحة بن البراء رضي الله عنه من الإكمال ) 1
# 33378 - اللهم ! الق طلحة يضحك إليك وتضحك إليه .
# % ( الباوردي والبغوي طب وأبو نعيم ؛ ض عن حصين بن وحوح - يعني طلحة ابن
~~البراء ) ( طلحة بن البراء بن عمير . أسد الغابة ( 3 / 82 ) . ص ) .
# | 1 ( أبو طلحة الأنصاري رضي الله عنه ) 1
# 33379 - لصوت أبي طلحة في الجيش خير من فئة .
# % ( حم ، ك - عن أنس ) ( أبو طلحة الأنصاري : اسمه ، زيد بن سهيل
~~الأنصاري البخاري توفي بالمدينة سنة احدى وثلاثين وعمره سبعون عاما أسد
~~الغابة ( 6 / 181 / 182 ) . والحديث أخرجه الحاكم في المستدرك ( 3 / 352 )
~~وقال : صحيح وأقره الذهبي ص ) .
# 33380 - صوت أبي طلحة في الجيش خير من ألف رجل .
# % ( سمويه - عن أنس ) .
# 33381 - لصوت أبي طلحة في الجيش خير من ألف رجل .
# % ( ك عن جابر ) .
